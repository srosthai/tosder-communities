{
  "name": "tosder-communities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "astro dev",
    "prebuild": "prisma generate",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env.local ./dist/server/entry.mjs",
    "check": "astro check",
    "test:visual": "playwright test tests/visual",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "playwright test",
    "test:admin": "playwright test tests/admin",
    "test:a11y": "playwright test --grep accessibility",
    "lighthouse": "lhci autorun",
    "db:seed": "node prisma/seed.mjs",
    "db:check": "node scripts/check-geography.mjs",
    "test:auth": "AUTH_E2E=true playwright test tests/auth tests/admin/content-editor.spec.ts tests/creator tests/trips tests/saves tests/reviews tests/engagement tests/e2e tests/admin/operations.spec.ts --workers=1",
    "db:deploy": "prisma migrate deploy",
    "db:content-check": "node scripts/check-content.mjs",
    "db:template-check": "node scripts/check-template-schema.mjs",
    "db:trip-check": "node scripts/check-trip-schema.mjs",
    "db:usage-recompute": "node scripts/recompute-usage.mjs",
    "db:rls-check": "node scripts/check-rls.mjs",
    "vercel-build": "prisma generate && astro check && astro build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@lucide/astro": "^1.73.0",
    "@neon/auth": "^0.8.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/vercel": "^11.0.22",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
