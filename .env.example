# Neon Postgres — pooled connection for the application runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&pgbouncer=true"

# Neon Postgres — direct connection for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-characters"

# Observability
LOG_LEVEL="info"
RELEASE="local"

# Temporary content-admin allowlist until RBAC (#47)
CONTENT_ADMIN_EMAILS="admin@example.com,your-email@example.com"

# Local authenticated Playwright tests
E2E_TEST_EMAIL="admin@example.com"
E2E_TEST_PASSWORD="choose-a-local-test-password"

# Object storage (Neon object storage is S3-compatible)
S3_ENDPOINT="https://<branch-id>.storage.<region>.aws.neon.tech"
S3_REGION="ap-southeast-1"
S3_BUCKET="tosder-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# One-off production release commands (never add these to Vercel)
# PRODUCTION_DATABASE_URL="postgresql://..."
# PRODUCTION_DIRECT_URL="postgresql://..."

# One-time production account provisioning (never commit real values)
# SEED_ADMIN_EMAIL="seed@your-domain"
# SUPERADMIN_EMAIL="you@your-domain"
# PROVISION_BASE_URL="https://your-production-url"
