---
import PublicPage from '../components/public/PublicPage.astro';
import AuthCard from '../components/public/AuthCard.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import { getAuthForRequest } from '../lib/auth-server';

export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
let errorMessage: string | null = null;
let reset = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  const submittedToken = String(form.get('token') ?? token);

  if (!submittedToken) {
    errorMessage = 'This reset link is missing a token. Request a new link.';
  } else if (password.length < 8) {
    errorMessage = 'Use at least 8 characters for your password.';
  } else if (password !== confirm) {
    errorMessage = 'The passwords do not match.';
  } else {
    const auth = getAuthForRequest(Astro);
    const result = await auth.resetPassword({
      newPassword: password,
      token: submittedToken,
    });

    if (result.error) {
      errorMessage = result.error.message ?? 'Unable to reset the password.';
    } else {
      reset = true;
    }
  }
}
---

<PublicPage
  label="Account"
  title="Choose a new password"
  description="Set a new password for your account. Existing sessions may need to sign in again."
  noindex
>
  <AuthCard error={errorMessage}>
    {reset ? (
      <div class="sent">
        <p>Your password has been updated.</p>
        <a href="/sign-in">Sign in with the new password</a>
      </div>
    ) : !token && Astro.request.method !== 'POST' ? (
      <div class="sent">
        <p>This reset link is missing a token. Request a new link to continue.</p>
        <a href="/forgot-password">Request a new reset link</a>
      </div>
    ) : (
      <form method="post" class="auth-form">
        <input type="hidden" name="token" value={token} />
        <Input
          label="New password"
          name="password"
          type="password"
          autocomplete="new-password"
          hint="At least 8 characters."
          required
        />
        <Input
          label="Confirm new password"
          name="confirm"
          type="password"
          autocomplete="new-password"
          required
        />
        <Button type="submit" variant="primary" block>Update password</Button>
      </form>
    )}
    <div class="auth-links">
      <a href="/sign-in">Back to sign in</a>
    </div>
  </AuthCard>
</PublicPage>

<style>
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sent {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .sent a {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .auth-links {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .auth-links a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-text-subtle);
    text-underline-offset: 2px;
  }
</style>
