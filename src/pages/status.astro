---
import { ArrowLeft, CircleAlert, CircleCheck, Database, ExternalLink } from '@lucide/astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import Badge from '../components/ui/Badge.astro';
import { getPrisma, isDatabaseConfigured } from '../db/prisma';

interface Todo {
  id: string;
  name: string;
}

let todos: Todo[] = [];
let errorMessage: string | null = null;
const configured = isDatabaseConfigured();

if (configured) {
  try {
    todos = await getPrisma().todo.findMany({
      select: { id: true, name: true },
      orderBy: { createdAt: 'asc' },
    });
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : 'Unable to reach Neon.';
  }
} else {
  errorMessage = 'DATABASE_URL is not configured for this environment.';
}

const healthy = configured && !errorMessage;
---

<PublicLayout title="System status — Tosder Communities"
  noindex>
  <section class="status-page">
    <div class="container">
      <a class="back-link" href="/">
        <ArrowLeft size={14} stroke-width={1.75} />
        Back to home
      </a>

      <div class="status-card">
        <div class="status-card__header">
          <div class="status-card__title">
            <span class="status-icon" aria-hidden="true">
              {healthy ? <CircleCheck size={18} stroke-width={1.75} /> : <CircleAlert size={18} stroke-width={1.75} />}
            </span>
            <div>
              <h1>System status</h1>
              <p>Backend connectivity for the current environment.</p>
            </div>
          </div>
          <Badge variant={healthy ? 'success' : 'danger'} dot>
            {healthy ? 'Connected' : 'Needs attention'}
          </Badge>
        </div>

        <dl class="status-facts">
          <div>
            <dt>Database</dt>
            <dd>{configured ? 'Neon Postgres' : 'Not configured'}</dd>
          </div>
          <div>
            <dt>Todos table</dt>
            <dd>{healthy ? 'Available' : 'Unavailable'}</dd>
          </div>
          <div>
            <dt>Runtime</dt>
            <dd>Astro server</dd>
          </div>
        </dl>

        {errorMessage ? (
          <p class="status-message status-message--error">{errorMessage}</p>
        ) : todos.length === 0 ? (
          <p class="status-message">The connection works. Add a row to the <code>todos</code> table to see it here.</p>
        ) : (
          <div class="todo-list">
            <h2>Seeded check rows</h2>
            <ul>
              {todos.map((todo) => <li>{todo.name}</li>)}
            </ul>
          </div>
        )}

        <div class="status-links">
          <a href="/api/health">
            <Database size={14} stroke-width={1.75} />
            API health
          </a>
          <a href="/api/todos">
            Todos API
            <ExternalLink size={13} stroke-width={1.75} />
          </a>
          <a href="/design">Design system</a>
          <a href="/admin">Admin preview</a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .status-page {
    padding: clamp(var(--space-8), 8vw, 5rem) 0;
  }

  .container {
    width: min(100% - var(--space-8), 44rem);
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .status-card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .status-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .status-card__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .status-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
  }

  h1 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.025em;
  }

  .status-card__header p {
    margin-top: 2px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .status-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-bg-subtle);
  }

  .status-facts dt {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .status-facts dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .status-message {
    padding: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .status-message--error {
    color: var(--color-danger-text);
  }

  .todo-list {
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .todo-list h2 {
    margin-bottom: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .todo-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .todo-list li {
    padding: var(--space-2) 0;
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .todo-list li:last-child {
    border-bottom: 0;
  }

  .status-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-xs);
  }

  .status-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }

  .status-links a:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 560px) {
    .status-card__header {
      flex-direction: column;
    }

    .status-facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
