---
import { ArrowLeft, CircleAlert, CircleCheck, Database, ExternalLink } from '@lucide/astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import Badge from '../components/ui/Badge.astro';
import { checkDatabase, getPrisma, isDatabaseConfigured } from '../db/prisma';
import { NEON_AUTH_BASE_URL } from 'astro:env/server';

const database = await checkDatabase();
const configured = isDatabaseConfigured();
const authConfigured = Boolean(NEON_AUTH_BASE_URL);
const storageConfigured = Boolean(
  process.env.S3_ENDPOINT &&
    process.env.S3_BUCKET &&
    process.env.S3_ACCESS_KEY_ID &&
    process.env.S3_SECRET_ACCESS_KEY,
);

let schemaReady = false;
let counts = { destinations: 0, templates: 0, competitions: 0 };
let schemaError: string | null = null;

if (database.reachable) {
  try {
    const rows = await getPrisma().$queryRaw<Array<{
      templates_table: boolean;
      destinations: number;
      templates: number;
      competitions: number;
    }>>`
      SELECT
        to_regclass('public.travel_templates') IS NOT NULL AS templates_table,
        (SELECT count(*)::int FROM destinations WHERE status = 'PUBLISHED') AS destinations,
        (SELECT count(*)::int FROM travel_templates WHERE status = 'PUBLISHED') AS templates,
        (SELECT count(*)::int FROM competitions WHERE status = 'ACTIVE') AS competitions
    `;
    const row = rows[0];
    if (row) {
      schemaReady = row.templates_table;
      counts = {
        destinations: row.destinations,
        templates: row.templates,
        competitions: row.competitions,
      };
    }
  } catch (error) {
    schemaError = error instanceof Error ? error.message : 'Schema check failed.';
  }
}

const healthy = database.reachable === true && schemaReady;
---

<PublicLayout title="System status — Tosder Communities" noindex>
  <section class="status-page">
    <div class="container">
      <a class="back-link" href="/">
        <ArrowLeft size={14} stroke-width={1.75} />
        Back to home
      </a>

      <div class="status-card">
        <div class="status-card__header">
          <div class="status-card__title">
            <span class="status-icon" aria-hidden="true">
              {healthy ? <CircleCheck size={18} stroke-width={1.75} /> : <CircleAlert size={18} stroke-width={1.75} />}
            </span>
            <div>
              <h1>System status</h1>
              <p>Backend, schema, auth, and storage readiness for this environment.</p>
            </div>
          </div>
          <Badge variant={healthy ? 'success' : 'danger'} dot>
            {healthy ? 'Ready' : 'Needs attention'}
          </Badge>
        </div>

        <dl class="status-facts">
          <div>
            <dt>Database</dt>
            <dd>{configured ? (database.reachable ? 'Neon Postgres reachable' : 'Unreachable') : 'Not configured'}</dd>
          </div>
          <div>
            <dt>Schema</dt>
            <dd>{schemaReady ? 'Ready' : 'Partial or missing'}</dd>
          </div>
          <div>
            <dt>Auth</dt>
            <dd>{authConfigured ? 'Configured' : 'Not configured'}</dd>
          </div>
          <div>
            <dt>Photo storage</dt>
            <dd>{storageConfigured ? 'Configured' : 'Not configured'}</dd>
          </div>
          <div>
            <dt>Runtime</dt>
            <dd>Astro server</dd>
          </div>
        </dl>

        {database.message && (
          <p class="status-message status-message--error">{database.message}</p>
        )}
        {schemaError && (
          <p class="status-message status-message--error">{schemaError}</p>
        )}
        {!schemaReady && !schemaError && (
          <p class="status-message status-message--error">
            The database is reachable, but the application tables are not ready. Run the
            production migrations and reload this page.
          </p>
        )}

        <div class="status-counts">
          <h2>Published catalog</h2>
          <dl>
            <div><dt>Destinations</dt><dd>{counts.destinations}</dd></div>
            <div><dt>Templates</dt><dd>{counts.templates}</dd></div>
            <div><dt>Active competitions</dt><dd>{counts.competitions}</dd></div>
          </dl>
        </div>

        <div class="status-links">
          <a href="/api/health">
            <Database size={14} stroke-width={1.75} />
            API health
          </a>
          <a href="/templates">
            Travel templates
            <ExternalLink size={13} stroke-width={1.75} />
          </a>
          <a href="/leaderboard">Leaderboard</a>
          <a href="/design">Design system</a>
          <a href="/admin">Admin preview</a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .status-page { padding: clamp(var(--space-8), 8vw, 5rem) 0; }
  .container { width: min(100% - var(--space-8), 44rem); margin: 0 auto; }
  .back-link { display: inline-flex; align-items: center; gap: var(--space-1); margin-bottom: var(--space-6); color: var(--color-text-muted); font-size: var(--text-sm); }
  .back-link:hover { color: var(--color-text); }
  .status-card { border: var(--border-width) solid var(--color-border); border-radius: var(--radius-xl); background: var(--color-surface); box-shadow: var(--shadow-sm); overflow: hidden; }
  .status-card__header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); padding: var(--space-5); border-bottom: var(--border-width) solid var(--color-border); }
  .status-card__title { display: flex; align-items: center; gap: var(--space-3); }
  .status-icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; flex: none; border: var(--border-width) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-subtle); color: var(--color-text-muted); }
  h1 { font-size: var(--text-xl); font-weight: var(--weight-semibold); letter-spacing: -0.02em; }
  .status-card__title p { margin-top: 2px; color: var(--color-text-muted); font-size: var(--text-sm); }
  .status-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin: 0; padding: var(--space-5); border-bottom: var(--border-width) solid var(--color-border); background: var(--color-bg-subtle); }
  .status-facts dt { color: var(--color-text-subtle); font-size: var(--text-xs); }
  .status-facts dd { margin: 2px 0 0; color: var(--color-text); font-size: var(--text-xs); }
  .status-message { margin: var(--space-4) var(--space-5) 0; padding: var(--space-3); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-md); font-size: var(--text-sm); }
  .status-message--error { border-color: var(--color-danger-border); background: var(--color-danger-bg); color: var(--color-danger-text); }
  .status-counts { padding: var(--space-5); border-top: var(--border-width) solid var(--color-border); }
  .status-counts h2 { font-size: var(--text-sm); font-weight: var(--weight-semibold); }
  .status-counts dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); margin-top: var(--space-3); }
  .status-counts dt { color: var(--color-text-subtle); font-size: var(--text-xs); }
  .status-counts dd { margin: 2px 0 0; font-family: var(--font-mono); font-size: var(--text-lg); }
  .status-links { display: flex; flex-wrap: wrap; gap: var(--space-3); padding: var(--space-5); border-top: var(--border-width) solid var(--color-border); }
  .status-links a { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--color-text-muted); font-size: var(--text-sm); }
  .status-links a:hover { color: var(--color-text); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 640px) {
    .status-card__header { flex-direction: column; }
    .status-facts, .status-counts dl { grid-template-columns: 1fr 1fr; }
  }
</style>
