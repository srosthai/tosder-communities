---
import { ArrowRight, LogOut, ShieldCheck, UserRound } from '@lucide/astro';
import PublicPage from '../components/public/PublicPage.astro';
import PublicButton from '../components/public/PublicButton.astro';
import Badge from '../components/ui/Badge.astro';
import { getAuthForRequest } from '../lib/auth-server';
import { getSessionUser } from '../lib/auth-user';
import { getMemberNotifications } from '../lib/reports';
import { deleteAccount } from '../lib/account';
import { ensureMemberProfile } from '../lib/profiles';

export const prerender = false;

const auth = getAuthForRequest(Astro);
const user = await getSessionUser(Astro);

if (!user) {
  return Astro.redirect('/sign-in?redirectTo=/account');
}

await ensureMemberProfile(user);
let accountError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('intent') ?? '') === 'delete-account') {
    if (String(form.get('confirmation') ?? '') !== 'DELETE') {
      accountError = 'Type DELETE exactly to confirm account deletion.';
    } else {
      await deleteAccount(user.id);
      await auth.signOut();
      return Astro.redirect('/sign-in?deleted=1');
    }
  }
}

const notifications = await getMemberNotifications(user.id);
---

<PublicPage
  label="Account"
  title="Your account"
  description="One profile for trips, saved places, and the creator workspace."
  noindex
>
  <div class="account-card">
    <div class="account-card__header">
      <span class="account-avatar" aria-hidden="true">
        <UserRound size={18} stroke-width={1.75} />
      </span>
      <div>
        <h2>{user.name}</h2>
        <p>{user.email}</p>
      </div>
      <Badge variant="success" dot>Signed in</Badge>
    </div>

    <dl class="account-facts">
      <div>
        <dt>Member ID</dt>
        <dd>{user.id}</dd>
      </div>
      <div>
        <dt>Email status</dt>
        <dd>{user.emailVerified ? 'Verified' : 'Verification pending'}</dd>
      </div>
      <div>
        <dt>Session</dt>
        <dd>Managed Neon Auth</dd>
      </div>
    </dl>

    <div class="account-actions">
      <PublicButton href="/creator">
        Open Creator Studio
        <ArrowRight size={14} stroke-width={2} />
      </PublicButton>
      <PublicButton href="/trips" variant="secondary">My Trips</PublicButton>
      <PublicButton href="/saved" variant="secondary">Saved items</PublicButton>
      <PublicButton href="/admin" variant="secondary">Open the admin preview</PublicButton>
      {!user.emailVerified && (
        <a class="verify-link" href="/verify-email">Verify email</a>
      )}
    </div>

    <form method="post" action="/api/auth/sign-out" class="signout-form">
      <button type="submit" class="signout-button">
        <LogOut size={14} stroke-width={1.75} />
        Sign out
      </button>
    </form>

    <p class="account-note">
      <ShieldCheck size={13} stroke-width={1.75} />
      Public templates never expose private trip data.
    </p>

    <section class="privacy" aria-labelledby="privacy-heading">
      <h2 id="privacy-heading">Privacy and account data</h2>
      <p>
        Download a copy of your profile, trips, saves, reviews, templates, usage
        records, and rewards. The export is JSON.
      </p>
      <a class="export-link" href="/api/account/export" download>Download my data</a>

      <details class="delete-account">
        <summary>Delete my account</summary>
        <p>
          This anonymizes your profile, archives your templates, deletes private
          trips, saves, likes, reviews, and notifications, and signs you out.
          Usage and payout records may be retained for competition and financial
          integrity, without your name or contact details.
        </p>
        {accountError && <p class="privacy-error" role="alert">{accountError}</p>}
        <form method="post" class="delete-form">
          <input type="hidden" name="intent" value="delete-account" />
          <label>
            Type DELETE to confirm
            <input name="confirmation" required autocomplete="off" />
          </label>
          <button type="submit">Delete account</button>
        </form>
      </details>
    </section>

    {notifications.length > 0 && (
      <section class="notifications" aria-labelledby="notifications-heading">
        <h2 id="notifications-heading">Moderation notifications</h2>
        <ul>
          {notifications.map((notification) => (
            <li>
              <strong>{notification.title}</strong>
              {notification.body && <p>{notification.body}</p>}
              <span>{notification.createdAt.toLocaleDateString('en', { month: 'short', day: 'numeric' })}</span>
              {notification.link && <a href={notification.link}>Open</a>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</PublicPage>

<style>
  .account-card {
    max-width: 40rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .account-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .account-avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
  }

  .account-card__header h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
  }

  .account-card__header p {
    margin-top: 2px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .account-card__header :global(.badge) {
    margin-left: auto;
  }

  .account-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-bg-subtle);
  }

  .account-facts dt {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .account-facts dd {
    margin: 2px 0 0;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .account-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .verify-link {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .verify-link:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .signout-form {
    margin: 0;
    padding: 0 var(--space-5) var(--space-4);
  }

  .signout-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-danger-text);
    font-size: var(--text-xs);
  }

  .signout-button:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy {
    margin: 0 var(--space-5) var(--space-5);
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-sunken);
  }

  .privacy h2 {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .privacy p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  .export-link {
    display: inline-flex;
    margin-top: var(--space-2);
    color: var(--color-text);
    font-size: var(--text-xs);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .delete-account {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
  }

  .delete-account summary {
    color: var(--color-danger-text);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .privacy-error {
    color: var(--color-danger-text) !important;
  }

  .delete-form {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  .delete-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .delete-form input {
    height: var(--control-height-sm);
    padding: 0 var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .delete-form button {
    height: var(--control-height-sm);
    padding: 0 var(--space-2);
    border: var(--border-width) solid var(--color-danger-border);
    border-radius: var(--radius-sm);
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
    font-size: var(--text-sm);
  }

  .notifications {
    margin: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }

  .notifications h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .notifications ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notifications li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
  }

  .notifications p {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .notifications span {
    color: var(--color-text-subtle);
  }

  .notifications a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .account-note {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  @media (max-width: 600px) {
    .account-card__header {
      flex-wrap: wrap;
    }

    .account-card__header :global(.badge) {
      margin-left: 0;
    }

    .account-facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
