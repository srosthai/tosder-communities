---
import { ArrowRight, Banknote, Check, CircleAlert, ShieldCheck } from '@lucide/astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { ApiError } from '../../lib/api';
import { getAdministratorAccess } from '../../lib/admin-auth';
import { getPrisma } from '../../db/prisma';
import {
  approveReward,
  listRewards,
  markRewardPaid,
  rewardReconciliation,
  rewardStatusLabel,
  voidReward,
} from '../../lib/rewards';

export const prerender = false;

const { user, allowed } = await getAdministratorAccess(Astro);
if (!user) {
  return Astro.redirect(`/sign-in?redirectTo=${encodeURIComponent(Astro.url.pathname)}`);
}

if (allowed && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const rewardId = String(form.get('rewardId') ?? '');

  try {
    if (intent === 'approve') {
      await approveReward({ id: user.id, email: user.email }, rewardId, String(form.get('reason') ?? ''));
    }
    if (intent === 'pay') {
      await markRewardPaid({ id: user.id, email: user.email }, rewardId, {
        reference: String(form.get('reference') ?? ''),
        method: String(form.get('method') ?? 'manual'),
        proofUrl: String(form.get('proofUrl') ?? ''),
      });
    }
    if (intent === 'void') {
      await voidReward({ id: user.id, email: user.email }, rewardId, String(form.get('reason') ?? ''));
    }
    return Astro.redirect('/admin/rewards?notice=updated');
  } catch (error) {
    const message = error instanceof ApiError ? error.message : 'The action could not be completed.';
    return Astro.redirect(`/admin/rewards?error=${encodeURIComponent(message)}`);
  }
}

const rewards = allowed ? await listRewards() : [];
const competitionId = Astro.url.searchParams.get('competition');
const competitions = allowed
  ? await getPrisma().competition.findMany({
      where: { status: { in: ['FINALIZED'] } },
      orderBy: { endsAt: 'desc' },
      include: { prizes: { orderBy: { rank: 'asc' } } },
    })
  : [];
const reconciliation = competitionId ? await rewardReconciliation(competitionId) : null;
const selectedCompetition = competitionId
  ? await getPrisma().competition.findUnique({ where: { id: competitionId }, select: { title: true, currency: true } })
  : null;
const notice = Astro.url.searchParams.get('notice');
const error = Astro.url.searchParams.get('error');
const filtered = competitionId ? rewards.filter((reward) => reward.competitionId === competitionId) : rewards;
const money = (cents: number, currency: string) =>
  new Intl.NumberFormat('en', { style: 'currency', currency, maximumFractionDigits: 0 }).format(cents / 100);
---

<AdminLayout title="Rewards">
  <PageHeader
    title="Reward ledger"
    description="Approve finalized competition rewards and record manual payouts with a reference. No money moves automatically."
  >
    <a class="header-link" href="/admin/competitions">Competitions <ArrowRight size={12} stroke-width={2} /></a>
  </PageHeader>

  {notice === 'updated' && <p class="notice notice--success" role="status">Reward ledger updated.</p>}
  {error && <p class="notice notice--error" role="alert">{error}</p>}

  <div class="banner">
    <ShieldCheck size={14} stroke-width={1.75} />
    Payout activation is gated by the M6 legal and compliance sign-off. This ledger records approved manual
    payouts only.
  </div>

  {!allowed ? (
    <p class="forbidden" role="alert">Administrator access required.</p>
  ) : (
    <>
      <form method="get" class="filter">
        <label>
          <span>Competition</span>
          <select name="competition">
            <option value="">All finalized competitions</option>
            {competitions.map((competition) => (
              <option value={competition.id} selected={competitionId === competition.id}>{competition.title}</option>
            ))}
          </select>
        </label>
        <button type="submit">Filter</button>
        {competitionId && <a href="/admin/rewards">Clear</a>}
      </form>

      {reconciliation && (
        <div class:list={['reconciliation', { 'is-bad': !reconciliation.matches }]}>
          <CircleAlert size={14} stroke-width={1.75} />
          <span>
            {selectedCompetition?.title}: prizes {money(reconciliation.prizeTotal, selectedCompetition?.currency ?? 'USD')} ·
            rewards {money(reconciliation.rewardTotal, selectedCompetition?.currency ?? 'USD')} ·
            {reconciliation.matches ? ' reconciled' : ' mismatch'}
          </span>
        </div>
      )}

      {filtered.length === 0 ? (
        <div class="empty">
          <Banknote size={22} stroke-width={1.75} />
          <h2>No rewards yet.</h2>
          <p>Finalize a competition, then use “Create rewards” on its lifecycle panel.</p>
          <a class="primary-link" href="/admin/competitions">Open competitions</a>
        </div>
      ) : (
        <div class="reward-list">
          {filtered.map((reward) => (
            <article class="reward">
              <div class="reward-head">
                <div>
                  <strong>Rank {reward.rank} · {reward.recipient.displayName}</strong>
                  <span>@{reward.recipient.username} · {reward.competition.title}</span>
                </div>
                <span class="amount">{money(reward.amountCents, reward.currency)}</span>
                <Badge
                  variant={reward.status === 'PAID' ? 'success' : reward.status === 'VOID' ? 'neutral' : reward.status === 'APPROVED' ? 'info' : 'warning'}
                  dot
                >
                  {rewardStatusLabel[reward.status]}
                </Badge>
              </div>

              {reward.status === 'PENDING' && (
                <form method="post" class="action-form">
                  <input type="hidden" name="intent" value="approve" />
                  <input type="hidden" name="rewardId" value={reward.id} />
                  <input name="reason" required minlength="3" maxlength="500" placeholder="Approval reason / eligibility check" />
                  <Button type="submit" variant="primary" size="sm"><Check size={13} stroke-width={2} />Approve</Button>
                </form>
              )}

              {(reward.status === 'APPROVED' || reward.status === 'PAYABLE') && (
                <form method="post" class="action-form">
                  <input type="hidden" name="intent" value="pay" />
                  <input type="hidden" name="rewardId" value={reward.id} />
                  <input name="reference" required minlength="3" maxlength="120" placeholder="Payout reference" />
                  <input name="method" value="manual" maxlength="40" aria-label="Payout method" />
                  <input name="proofUrl" placeholder="Proof URL (optional)" />
                  <Button type="submit" variant="primary" size="sm"><Banknote size={13} stroke-width={2} />Mark paid</Button>
                </form>
              )}

              {reward.status !== 'PAID' && reward.status !== 'VOID' && (
                <form method="post" class="action-form action-form--quiet">
                  <input type="hidden" name="intent" value="void" />
                  <input type="hidden" name="rewardId" value={reward.id} />
                  <input name="reason" required minlength="3" maxlength="500" placeholder="Void reason" />
                  <Button type="submit" variant="danger" size="sm">Void</Button>
                </form>
              )}

              {reward.status === 'PAID' && (
                <p class="paid-note">
                  Paid {reward.paidAt?.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })} ·
                  reference {reward.payoutReference} · method {reward.payoutMethod}
                </p>
              )}
              {reward.status === 'VOID' && <p class="void-note">Void: {reward.voidReason}</p>}
            </article>
          ))}
        </div>
      )}
    </>
  )}
</AdminLayout>

<style>
  .header-link { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--color-text-muted); font-size: var(--text-sm); text-decoration: underline; text-underline-offset: 2px; }
  .notice { margin-bottom: var(--space-4); padding: var(--space-3) var(--space-4); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-md); font-size: var(--text-sm); }
  .notice--success { background: var(--color-success-bg); color: var(--color-success-text); border-color: color-mix(in oklch, var(--color-success) 40%, transparent); }
  .notice--error { background: var(--color-danger-bg); color: var(--color-danger-text); border-color: color-mix(in oklch, var(--color-danger) 40%, transparent); }
  .banner { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-subtle); color: var(--color-text-muted); font-size: var(--text-xs); }
  .forbidden, .empty { padding: var(--space-6); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); color: var(--color-text-muted); font-size: var(--text-sm); }
  .empty { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); text-align: center; }
  .empty h2 { color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-semibold); }
  .primary-link { color: var(--color-text); font-size: var(--text-sm); text-decoration: underline; text-underline-offset: 2px; }
  .filter { display: flex; align-items: flex-end; gap: var(--space-2); margin-bottom: var(--space-3); }
  .filter label { display: flex; flex-direction: column; gap: var(--space-1); }
  .filter span { color: var(--color-text-subtle); font-size: var(--text-xs); }
  .filter select, .filter button { height: var(--control-height-sm); padding: 0 var(--space-2); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text); font-size: var(--text-sm); }
  .filter a { color: var(--color-text-subtle); font-size: var(--text-xs); text-decoration: underline; }
  .reconciliation { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); color: var(--color-success-text); font-size: var(--text-xs); }
  .reconciliation.is-bad { color: var(--color-danger-text); }
  .reward-list { display: flex; flex-direction: column; gap: var(--space-2); }
  .reward { padding: var(--space-3); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .reward-head { display: flex; align-items: center; gap: var(--space-3); }
  .reward-head > div { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .reward-head strong { font-size: var(--text-sm); }
  .reward-head span { color: var(--color-text-subtle); font-size: var(--text-xs); }
  .amount { color: var(--color-text); font-family: var(--font-mono); font-size: var(--text-sm); }
  .action-form { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2); flex-wrap: wrap; }
  .action-form input { height: var(--control-height-sm); padding: 0 var(--space-2); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text); font-size: var(--text-sm); }
  .action-form input:first-of-type { flex: 1; min-width: 12rem; }
  .action-form--quiet { opacity: 0.75; }
  .paid-note, .void-note { margin-top: var(--space-2); color: var(--color-text-subtle); font-size: var(--text-xs); }
  .void-note { color: var(--color-danger-text); }
</style>
