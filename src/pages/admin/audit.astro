---
import type { Prisma } from '@prisma/client';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import { getAdministratorAccess } from '../../lib/admin-auth';
import { getPrisma } from '../../db/prisma';

export const prerender = false;

const { user, allowed } = await getAdministratorAccess(Astro);
if (!user) {
  return Astro.redirect(`/sign-in?redirectTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const actor = Astro.url.searchParams.get('actor')?.trim() ?? '';
const action = Astro.url.searchParams.get('action')?.trim() ?? '';
const entityType = Astro.url.searchParams.get('entity')?.trim() ?? '';
const from = Astro.url.searchParams.get('from')?.trim() ?? '';
const to = Astro.url.searchParams.get('to')?.trim() ?? '';
const page = Number(Astro.url.searchParams.get('page') ?? '1') || 1;
const pageSize = 25;

const where: Prisma.AuditEventWhereInput = {};
if (actor) where.actorEmail = { contains: actor, mode: 'insensitive' };
if (action) where.action = { contains: action, mode: 'insensitive' };
if (entityType) where.entityType = entityType;
if (from || to) {
  where.createdAt = {
    ...(from ? { gte: new Date(`${from}T00:00:00.000Z`) } : {}),
    ...(to ? { lte: new Date(`${to}T23:59:59.999Z`) } : {}),
  };
}

const [total, events, entityTypes, actions] = allowed
  ? await Promise.all([
      getPrisma().auditEvent.count({ where }),
      getPrisma().auditEvent.findMany({
        where,
        orderBy: { createdAt: 'desc' },
        skip: (Math.max(page, 1) - 1) * pageSize,
        take: pageSize,
      }),
      getPrisma().auditEvent.findMany({
        distinct: ['entityType'],
        select: { entityType: true },
        orderBy: { entityType: 'asc' },
      }),
      getPrisma().auditEvent.findMany({
        distinct: ['action'],
        select: { action: true },
        orderBy: { action: 'asc' },
      }),
    ])
  : [0, [], [], []];

const totalPages = Math.max(1, Math.ceil(total / pageSize));
const currentPage = Math.min(Math.max(page, 1), totalPages);

const query = (overrides: Record<string, string | number | undefined>) => {
  const params = new URLSearchParams();
  if (actor) params.set('actor', actor);
  if (action) params.set('action', action);
  if (entityType) params.set('entity', entityType);
  if (from) params.set('from', from);
  if (to) params.set('to', to);
  if (currentPage > 1) params.set('page', String(currentPage));
  for (const [key, value] of Object.entries(overrides)) {
    if (value === undefined || value === '') params.delete(key);
    else params.set(key, String(value));
  }
  const search = params.toString();
  return search ? `/admin/audit?${search}` : '/admin/audit';
};

const exportUrl = `/api/admin/audit/export?${new URLSearchParams({
  ...(actor ? { actor } : {}),
  ...(action ? { action } : {}),
  ...(entityType ? { entity: entityType } : {}),
  ...(from ? { from } : {}),
  ...(to ? { to } : {}),
}).toString()}`;
---

<AdminLayout title="Audit log">
  <PageHeader
    title="Audit log"
    description="Append-only events for privileged mutations. Entries cannot be edited through the application."
  >
    <a class="export-link" href={exportUrl} download>Export CSV</a>
  </PageHeader>

  {!allowed ? (
    <p class="forbidden" role="alert">Administrator access required.</p>
  ) : (
    <>
      <form method="get" class="filters">
        <label>
          <span>Actor email</span>
          <input name="actor" value={actor} placeholder="name@example.com" />
        </label>
        <label>
          <span>Action</span>
          <input name="action" value={action} placeholder="template.published" list="audit-actions" />
          <datalist id="audit-actions">
            {actions.map((entry) => <option value={entry.action}></option>)}
          </datalist>
        </label>
        <label>
          <span>Entity</span>
          <select name="entity">
            <option value="">All entities</option>
            {entityTypes.map((entry) => (
              <option value={entry.entityType} selected={entityType === entry.entityType}>
                {entry.entityType}
              </option>
            ))}
          </select>
        </label>
        <label>
          <span>From</span>
          <input type="date" name="from" value={from} />
        </label>
        <label>
          <span>To</span>
          <input type="date" name="to" value={to} />
        </label>
        <button type="submit">Filter</button>
        {(actor || action || entityType || from || to) && <a href="/admin/audit">Clear</a>}
      </form>

      <div class="summary">
        <Badge variant="info" dot>{total} events</Badge>
        <span>Page {currentPage} of {totalPages}</span>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Time</th>
              <th scope="col">Actor</th>
              <th scope="col">Action</th>
              <th scope="col">Entity</th>
              <th scope="col">Summary</th>
              <th scope="col">Reason</th>
              <th scope="col">Request</th>
            </tr>
          </thead>
          <tbody>
            {events.length === 0 ? (
              <tr><td colspan="7" class="empty">No audit events match these filters.</td></tr>
            ) : (
              events.map((event) => (
                <tr>
                  <td class="mono">{event.createdAt.toLocaleString('en', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}</td>
                  <td>{event.actorEmail}</td>
                  <td><code>{event.action}</code></td>
                  <td>{event.entityType}{event.entityId ? ` · ${event.entityId.slice(0, 8)}` : ''}</td>
                  <td>{event.summary}</td>
                  <td class="muted">{event.reason ?? '—'}</td>
                  <td class="mono">{event.requestId ? event.requestId.slice(0, 14) : '—'}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Audit pages">
          {currentPage > 1 ? <a href={query({ page: currentPage - 1 })}>Previous</a> : <span />}
          <span>Page {currentPage} of {totalPages}</span>
          {currentPage < totalPages ? <a href={query({ page: currentPage + 1 })}>Next</a> : <span />}
        </nav>
      )}

      <p class="retention">
        Retention: privileged audit events are retained for 7 years. Export is available to administrators.
        Secrets and unnecessary personal data are never written to audit entries.
      </p>
    </>
  )}
</AdminLayout>

<style>
  .export-link {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .forbidden {
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .filters {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    flex-wrap: wrap;
  }

  .filters label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .filters span {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .filters input,
  .filters select {
    height: var(--control-height-sm);
    padding: 0 var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .filters button {
    height: var(--control-height-sm);
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .filters a {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    text-decoration: underline;
  }

  .summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .table-wrap {
    overflow-x: auto;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
  }

  th {
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-sunken);
    color: var(--color-text-subtle);
    font-weight: var(--weight-medium);
    text-align: left;
    white-space: nowrap;
  }

  td {
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    vertical-align: top;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  code {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .mono {
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .muted {
    color: var(--color-text-subtle);
  }

  .empty {
    padding: var(--space-5);
    text-align: center;
    color: var(--color-text-subtle);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .pagination a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .retention {
    margin-top: var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }
</style>
