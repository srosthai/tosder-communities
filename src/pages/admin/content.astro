---
import { ChevronDown, MapPin, Plus } from '@lucide/astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import DataTable from '../../components/admin/DataTable.astro';
import SearchableSelect from '../../components/admin/SearchableSelect.astro';
import Badge from '../../components/ui/Badge.astro';
import { getPrisma } from '../../db/prisma';

const prisma = getPrisma();
const destinations = await prisma.destination.findMany({
  orderBy: { updatedAt: 'desc' },
  include: {
    province: { select: { name: true, slug: true } },
    categories: {
      take: 1,
      include: { category: { select: { name: true } } },
    },
  },
});

const provinces = await prisma.province.findMany({
  orderBy: { name: 'asc' },
  select: { name: true, slug: true },
});

const provinceOptions = [
  { value: '', label: 'All provinces' },
  ...provinces.map((province) => ({ value: province.slug, label: province.name })),
];

const rows = destinations.map((destination) => ({
  id: destination.id,
  name: destination.name,
  slug: destination.slug,
  province: destination.province.name,
  provinceSlug: destination.province.slug,
  category: destination.categories[0]?.category.name ?? '—',
  status: destination.status,
  updated: destination.updatedAt.toLocaleDateString('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }),
}));

const statusVariant = (status: string) =>
  status === 'PUBLISHED' ? 'success' : status === 'DRAFT' ? 'neutral' : 'warning';
---

<AdminLayout title="Content">
  <DataTable
    title="Destinations"
    description="Manage destinations, categories, photography, and public visibility."
    searchPlaceholder="Search destinations by name or province…"
    pageSize={5}
    filters={[
      { label: 'Published', value: 'published' },
      { label: 'Draft', value: 'draft' },
      { label: 'Archived', value: 'archived' },
    ]}
  >
    <MapPin slot="icon" size={18} stroke-width={1.75} />
    <a slot="actions" class="create-link create-link--secondary" href="/admin/content/taxonomy">
      Taxonomy
    </a>
    <a slot="actions" class="create-link" href="/admin/content/new">
      <Plus size={14} stroke-width={2} />
      New destination
    </a>

    <SearchableSelect
      slot="toolbar"
      name="province"
      label="Province"
      searchPlaceholder="Search provinces…"
      options={provinceOptions}
    />

    <thead>
      <tr>
        <th scope="col">Destination</th>
        <th scope="col">Province</th>
        <th scope="col">Category</th>
        <th scope="col">Status</th>
        <th scope="col">Templates</th>
        <th scope="col">Views</th>
        <th scope="col">Updated</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((destination) => (
        <tr
          data-search={`${destination.name} ${destination.province} ${destination.category} ${destination.status}`}
          data-filter={destination.status.toLowerCase()}
          data-province={destination.provinceSlug}
        >
          <td>
            <span class="cell-main">
              <span class="cell-icon" aria-hidden="true"><MapPin size={14} stroke-width={1.75} /></span>
              <span class="cell-copy">
                <strong>{destination.name}</strong>
                <span>{destination.category}</span>
              </span>
            </span>
          </td>
          <td>{destination.province}</td>
          <td>{destination.category}</td>
          <td><Badge variant={statusVariant(destination.status)} dot>{destination.status}</Badge></td>
          <td class="numeric">—</td>
          <td class="numeric">—</td>
          <td class="muted">{destination.updated}</td>
          <td class="actions">
            <a class="table-action" href={`/admin/content/${destination.id}`}>
              Edit <ChevronDown size={12} stroke-width={1.75} />
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </DataTable>

  <p class="page-note">Published content is indexable and available to template authors. Archived content keeps its references.</p>
</AdminLayout>

<style>
  .create-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: var(--control-height-md);
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .create-link:hover {
    background: var(--color-accent-hover);
  }

  .create-link--secondary {
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .create-link--secondary:hover {
    background: var(--color-surface-sunken);
  }

  .cell-main {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 12rem;
  }

  .cell-icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
  }

  .cell-copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .cell-copy strong {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }

  .cell-copy span {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .numeric {
    font-variant-numeric: tabular-nums;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .actions {
    text-align: right;
  }

  .table-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .table-action:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .page-note {
    margin-top: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }
</style>
