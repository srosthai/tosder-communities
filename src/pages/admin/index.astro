---
import {
  ArrowUpRight,
  Clock,
  Download,
  Flag,
  LayoutTemplate,
  Plus,
  ShieldAlert,
  Users,
  Wallet,
} from '@lucide/astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import Panel from '../../components/admin/Panel.astro';
import StatCard from '../../components/admin/StatCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Table from '../../components/ui/Table.astro';

const usage = [
  { label: 'W1', value: 720 },
  { label: 'W2', value: 780 },
  { label: 'W3', value: 810 },
  { label: 'W4', value: 790 },
  { label: 'W5', value: 860 },
  { label: 'W6', value: 910 },
  { label: 'W7', value: 980 },
  { label: 'W8', value: 1010 },
  { label: 'W9', value: 1120 },
  { label: 'W10', value: 1080 },
  { label: 'W11', value: 1190 },
  { label: 'W12', value: 1284 },
];

const maxUsage = Math.max(...usage.map((week) => week.value));

const topTemplates = [
  {
    name: 'Three days in Siem Reap',
    creator: 'Sokha Meas',
    uses: '184',
    conversion: '9.8%',
    status: 'Published',
  },
  {
    name: 'Phnom Penh in 48 hours',
    creator: 'Vannak Heng',
    uses: '142',
    conversion: '8.4%',
    status: 'Published',
  },
  {
    name: 'Kampot slow weekend',
    creator: 'Dara Lim',
    uses: '117',
    conversion: '7.9%',
    status: 'Published',
  },
  {
    name: 'Koh Rong dive and rest',
    creator: 'Malis Chhay',
    uses: '96',
    conversion: '7.1%',
    status: 'Published',
  },
  {
    name: 'Battambang countryside loop',
    creator: 'Pisey Nou',
    uses: '81',
    conversion: '6.6%',
    status: 'Published',
  },
];

const attention = [
  {
    icon: Clock,
    title: '4 templates pending over 24 hours',
    detail: 'Oldest: Kampot slow weekend',
    href: '/admin/templates',
    action: 'Review',
    tone: 'warning',
  },
  {
    icon: Flag,
    title: '2 high-priority reports',
    detail: 'Reported content is hidden from public pages',
    href: '/admin/moderation',
    action: 'Open queue',
    tone: 'danger',
  },
  {
    icon: Wallet,
    title: '1 payout awaiting approval',
    detail: '$120 · 2nd place · October competition',
    href: '/admin/rewards',
    action: 'Approve',
    tone: 'info',
  },
];

const activity = [
  {
    initials: 'SM',
    name: 'Sokha Meas',
    action: 'published a revision of',
    target: 'Three days in Siem Reap',
    time: '12 minutes ago',
  },
  {
    initials: 'DL',
    name: 'Dara Lim',
    action: 'submitted',
    target: 'Kampot slow weekend',
    time: '48 minutes ago',
  },
  {
    initials: 'VH',
    name: 'Vannak Heng',
    action: 'used a template and saved a trip',
    target: 'Coastal three-night plan',
    time: '2 hours ago',
  },
  {
    initials: 'MC',
    name: 'Malis Chhay',
    action: 'replied to feedback on',
    target: 'Koh Rong dive and rest',
    time: '3 hours ago',
  },
  {
    initials: 'PN',
    name: 'Pisey Nou',
    action: 'verified a destination',
    target: 'Battambang countryside',
    time: '5 hours ago',
  },
];
---

<AdminLayout title="Overview">
  <PageHeader
    title="Overview"
    description="A live view of content quality, creator activity, and the current competition."
  >
    <Badge variant="info">Preview data</Badge>
    <Button variant="secondary">
      <Download size={15} stroke-width={1.75} />
      Export
    </Button>
    <Button variant="primary">
      <Plus size={15} stroke-width={2} />
      Create template
    </Button>
  </PageHeader>

  <div class="stats-grid">
    <StatCard label="Qualified uses" value="1,284" trend="+18.4%" hint="vs. last month" tone="positive">
      <Users slot="icon" size={16} stroke-width={1.75} />
    </StatCard>
    <StatCard label="Published templates" value="86" trend="+6" hint="this month" tone="positive">
      <LayoutTemplate slot="icon" size={16} stroke-width={1.75} />
    </StatCard>
    <StatCard label="Pending review" value="12" trend="4 overdue" hint="oldest 31 hours" tone="warning">
      <ShieldAlert slot="icon" size={16} stroke-width={1.75} />
    </StatCard>
    <StatCard label="Open reports" value="5" trend="2 high priority" hint="moderation queue" tone="warning">
      <Flag slot="icon" size={16} stroke-width={1.75} />
    </StatCard>
  </div>

  <div class="dashboard-grid">
    <Panel
      title="Qualified uses"
      description="Weekly usage across all published templates."
      class="usage-panel"
    >
      <a slot="action" class="panel-link" href="/admin/templates">
        View templates <ArrowUpRight size={13} stroke-width={1.75} />
      </a>
      <div class="chart" role="img" aria-label="Qualified uses rose from 720 in week one to 1,284 in week twelve.">
        <div class="chart__plot">
          {usage.map((week, index) => (
            <div class="chart__column">
              <div
                class:list={['chart__bar', { 'is-current': index === usage.length - 1 }]}
                style={`--bar-height: ${(week.value / maxUsage) * 100}%`}
              ></div>
            </div>
          ))}
        </div>
        <div class="chart__labels" aria-hidden="true">
          {usage.map((week) => <span>{week.label}</span>)}
        </div>
      </div>
      <div class="chart__summary">
        <span><strong>1,284</strong> qualified uses</span>
        <span class="chart__delta">+18.4% from last month</span>
      </div>
    </Panel>

    <Panel title="Needs attention" description="Items that unblock the community.">
      <a slot="action" class="panel-link" href="/admin/moderation">
        Open queue <ArrowUpRight size={13} stroke-width={1.75} />
      </a>
      <ul class="attention-list">
        {attention.map((item) => {
          const Icon = item.icon;
          return (
            <li class="attention-item">
              <span class:list={['attention-icon', `attention-icon--${item.tone}`]} aria-hidden="true">
                <Icon size={15} stroke-width={1.75} />
              </span>
              <span class="attention-copy">
                <strong>{item.title}</strong>
                <span>{item.detail}</span>
              </span>
              <a class="attention-action" href={item.href}>{item.action}</a>
            </li>
          );
        })}
      </ul>
    </Panel>

    <Panel title="Top templates" description="By qualified uses in the current period.">
      <a slot="action" class="panel-link" href="/admin/templates">
        All templates <ArrowUpRight size={13} stroke-width={1.75} />
      </a>
      <Table>
        <thead>
          <tr>
            <th scope="col">Template</th>
            <th scope="col">Creator</th>
            <th scope="col">Uses</th>
            <th scope="col">Conv.</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {topTemplates.map((template) => (
            <tr>
              <td><strong>{template.name}</strong></td>
              <td>{template.creator}</td>
              <td class="numeric">{template.uses}</td>
              <td class="numeric">{template.conversion}</td>
              <td><Badge variant="success" dot>{template.status}</Badge></td>
            </tr>
          ))}
        </tbody>
      </Table>
    </Panel>

    <Panel title="November competition" description="Provisional Top 5 · closes in 9 days.">
      <a slot="action" class="panel-link" href="/admin/competitions">
        Configure <ArrowUpRight size={13} stroke-width={1.75} />
      </a>
      <div class="prize-row">
        <div>
          <span class="prize-label">Prize pool</span>
          <strong class="prize-value">$500</strong>
        </div>
        <Badge variant="warning" dot>Provisional</Badge>
      </div>
      <div class="competition-list">
        <div class="competition-row">
          <span class="rank">01</span>
          <span class="competition-name">Sokha Meas</span>
          <span class="competition-uses">184</span>
        </div>
        <div class="competition-row">
          <span class="rank">02</span>
          <span class="competition-name">Vannak Heng</span>
          <span class="competition-uses">142</span>
        </div>
        <div class="competition-row">
          <span class="rank">03</span>
          <span class="competition-name">Dara Lim</span>
          <span class="competition-uses">117</span>
        </div>
      </div>
      <div class="progress" role="img" aria-label="Competition period is 70 percent complete.">
        <span class="progress__bar" style="--progress: 70%"></span>
      </div>
      <p class="competition-note">21 of 30 days elapsed · rankings are provisional</p>
    </Panel>

    <Panel
      title="Recent activity"
      description="The latest creator and traveler actions."
      class="activity-panel"
    >
      <a slot="action" class="panel-link" href="/admin/audit">
        Audit log <ArrowUpRight size={13} stroke-width={1.75} />
      </a>
      <ul class="activity-list">
        {activity.map((item) => (
          <li class="activity-item">
            <span class="activity-avatar">{item.initials}</span>
            <span class="activity-copy">
              <span>
                <strong>{item.name}</strong> {item.action} <a href="/admin/templates">{item.target}</a>
              </span>
              <span class="activity-time">{item.time}</span>
            </span>
          </li>
        ))}
      </ul>
    </Panel>
  </div>
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.85fr);
    gap: var(--space-3);
  }

  .usage-panel {
    min-width: 0;
  }

  .activity-panel {
    grid-column: 1 / -1;
  }

  .panel-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .panel-link:hover {
    color: var(--color-text);
  }

  .chart {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .chart__plot {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    height: 11rem;
    padding: var(--space-2) var(--space-1) 0;
    border-bottom: var(--border-width) solid var(--color-border);
    background:
      linear-gradient(to bottom, var(--color-border) 1px, transparent 1px) 0 0 / 100% 25%;
  }

  .chart__column {
    display: flex;
    flex: 1;
    align-items: flex-end;
    height: 100%;
    min-width: 0;
  }

  .chart__bar {
    width: 100%;
    height: var(--bar-height);
    min-height: 2px;
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
    background: var(--chart-4);
    opacity: 0.55;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .chart__bar:hover {
    opacity: 1;
  }

  .chart__bar.is-current {
    background: var(--chart-3);
    opacity: 1;
  }

  .chart__labels {
    display: flex;
    gap: var(--space-2);
    padding: 0 var(--space-1);
  }

  .chart__labels span {
    flex: 1;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: center;
  }

  .chart__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .chart__summary strong {
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .chart__delta {
    color: var(--color-success-text);
    font-weight: var(--weight-medium);
  }

  .attention-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .attention-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .attention-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .attention-icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: var(--radius-md);
  }

  .attention-icon--warning {
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
  }

  .attention-icon--danger {
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
  }

  .attention-icon--info {
    background: var(--color-info-bg);
    color: var(--color-info-text);
  }

  .attention-copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .attention-copy strong {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .attention-copy span {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .attention-action {
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .attention-action:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .numeric {
    font-variant-numeric: tabular-nums;
  }

  .prize-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .prize-label {
    display: block;
    margin-bottom: 2px;
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .prize-value {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }

  .competition-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: var(--space-2) 0;
  }

  .competition-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 1.875rem;
    padding: 0 var(--space-1);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }

  .competition-row:hover {
    background: var(--color-surface-sunken);
  }

  .rank {
    width: 1.125rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .competition-name {
    flex: 1;
  }

  .competition-uses {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .progress {
    height: 4px;
    margin-top: var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-surface-sunken);
    overflow: hidden;
  }

  .progress__bar {
    display: block;
    width: var(--progress);
    height: 100%;
    border-radius: inherit;
    background: var(--chart-3);
  }

  .competition-note {
    margin-top: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .activity-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .activity-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .activity-avatar {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .activity-copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .activity-copy strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .activity-copy a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-text-subtle);
    text-underline-offset: 2px;
  }

  .activity-copy a:hover {
    text-decoration-color: currentColor;
  }

  .activity-time {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  @media (max-width: 1200px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .activity-panel {
      grid-column: auto;
    }
  }

  @media (max-width: 720px) {
    .stats-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .activity-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .chart__labels span:nth-child(even) {
      display: none;
    }
  }
</style>
