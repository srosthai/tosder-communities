---
import { Check, CircleAlert, Eye, X } from '@lucide/astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import Panel from '../../components/admin/Panel.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { ApiError } from '../../lib/api';
import { getContentAdmin } from '../../lib/admin-auth';
import { getCreatorTemplate } from '../../lib/templates';
import { validateTemplate, type BuilderTemplate } from '../../lib/template-builder';
import {
  approveTemplate,
  listPendingTemplates,
  rejectTemplate,
} from '../../lib/template-publishing';

export const prerender = false;

const { user, allowed } = await getContentAdmin(Astro);
if (!user) {
  return Astro.redirect(`/sign-in?redirectTo=${encodeURIComponent(Astro.url.pathname)}`);
}

let errorMessage: string | null = null;

if (allowed && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const templateId = String(form.get('templateId') ?? '');

  try {
    if (intent === 'approve') {
      const visibility = String(form.get('visibility') ?? 'public') === 'unlisted'
        ? 'unlisted'
        : 'public';
      await approveTemplate(templateId, { id: user.id, email: user.email }, { visibility });
      return Astro.redirect('/admin/moderation?notice=approved');
    }

    if (intent === 'reject') {
      const reason = String(form.get('reason') ?? '');
      await rejectTemplate(templateId, { id: user.id, email: user.email }, reason);
      return Astro.redirect('/admin/moderation?notice=rejected');
    }
  } catch (error) {
    const message = error instanceof ApiError ? error.message : 'The action could not be completed.';
    return Astro.redirect(`/admin/moderation?error=${encodeURIComponent(message)}`);
  }
}

const pending = await listPendingTemplates();
const selectedId = Astro.url.searchParams.get('template');
const selected = pending.find((template) => template.id === selectedId) ?? pending[0] ?? null;

const selectedTemplate = selected
  ? await getCreatorTemplate(selected.id, selected.creatorId)
  : null;

const validation = selectedTemplate
  ? validateTemplate(selectedTemplate as BuilderTemplate, {
      emailVerified: true,
      status: selectedTemplate.status,
    })
  : { blocking: [], warnings: [] };

const notice = Astro.url.searchParams.get('notice');
const error = Astro.url.searchParams.get('error');
const notices: Record<string, string> = {
  approved: 'Template approved and published.',
  rejected: 'Changes requested. The creator can revise and resubmit.',
};
---

<AdminLayout title="Moderation">
  <PageHeader
    title="Template review"
    description="Check completeness and safety before a template reaches travelers. Every decision is written to the audit trail."
  >
    <Badge variant={pending.length > 0 ? 'warning' : 'success'} dot>
      {pending.length} awaiting review
    </Badge>
  </PageHeader>

  {notice && notices[notice] && <p class="notice notice--success" role="status">{notices[notice]}</p>}
  {error && <p class="notice notice--error" role="alert">{error}</p>}

  {!allowed ? (
    <p class="forbidden" role="alert">
      Your account does not have content-admin access. Ask an administrator to add your email to the
      content-admin allowlist.
    </p>
  ) : pending.length === 0 ? (
    <div class="empty">
      <Check size={22} stroke-width={1.75} />
      <h2>No templates waiting.</h2>
      <p>New submissions appear here as soon as creators request review.</p>
    </div>
  ) : (
    <div class="moderation-grid">
      <Panel title="Review queue" description={`${pending.length} pending`}>
        <div class="queue" role="list" aria-label="Templates awaiting review">
          {pending.map((template) => (
            <a
              class:list={['queue-item', { 'is-active': template.id === selected?.id }]}
              href={`/admin/moderation?template=${template.id}`}
              role="listitem"
            >
              <span class="queue-main">
                <span class="queue-title">
                  <strong>{template.title}</strong>
                  <Badge variant="warning" dot>In review</Badge>
                </span>
                <span class="queue-meta">
                  {template.creator.displayName} · @{template.creator.username} ·{' '}
                  {template._count.days} {template._count.days === 1 ? 'day' : 'days'} ·{' '}
                  {template.province?.name ?? 'No province'}
                </span>
              </span>
              <span class="queue-id">
                {template.updatedAt.toLocaleDateString('en', { month: 'short', day: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
      </Panel>

      {selected && selectedTemplate && (
        <Panel
          title={selected.title}
          description={`Submitted by ${selected.creator.displayName} · @${selected.creator.username}`}
        >
          <div class="review">
            <div class="review__meta">
              <Badge variant="warning" dot>Pending review</Badge>
              <span>{selectedTemplate.durationDays} days</span>
              <span>{selectedTemplate.province?.name ?? 'No province'}</span>
              <a href={`/admin/moderation/${selected.id}`}>
                <Eye size={13} stroke-width={1.75} />
                Open full preview
              </a>
            </div>

            <p class="review__summary">{selectedTemplate.summary || 'No summary provided.'}</p>

            <section class="review__checks" aria-labelledby="review-checks-heading">
              <h3 id="review-checks-heading">Validation</h3>
              {validation.blocking.length === 0 ? (
                <p class="review__clear">
                  <Check size={14} stroke-width={2} />
                  No blocking issues.
                </p>
              ) : (
                <ul class="review__list review__list--blocking">
                  {validation.blocking.map((message) => <li>{message}</li>)}
                </ul>
              )}
              {validation.warnings.length > 0 && (
                <ul class="review__list review__list--warnings">
                  {validation.warnings.map((message) => <li>{message}</li>)}
                </ul>
              )}
            </section>

            <form method="post" class="review__form">
              <input type="hidden" name="intent" value="approve" />
              <input type="hidden" name="templateId" value={selected.id} />
              <label class="field">
                <span>Visibility</span>
                <select name="visibility">
                  <option value="public">Public — list and index</option>
                  <option value="unlisted">Unlisted — direct link only</option>
                </select>
              </label>
              <Button type="submit" variant="primary" disabled={validation.blocking.length > 0}>
                <Check size={15} stroke-width={1.75} />
                Approve and publish
              </Button>
            </form>

            <form method="post" class="review__reject">
              <input type="hidden" name="intent" value="reject" />
              <input type="hidden" name="templateId" value={selected.id} />
              <label class="field">
                <span>Reason for changes</span>
                <textarea
                  name="reason"
                  rows="3"
                  required
                  minlength="3"
                  maxlength="500"
                  placeholder="Explain what the creator needs to fix before resubmitting."
                ></textarea>
              </label>
              <Button type="submit" variant="danger">
                <X size={15} stroke-width={1.75} />
                Request changes
              </Button>
            </form>

            <p class="review__note">
              <CircleAlert size={13} stroke-width={1.75} />
              Approving creates an immutable version. Rejecting returns the draft to the creator with
              this reason.
            </p>
          </div>
        </Panel>
      )}
    </div>
  )}
</AdminLayout>

<style>
  .notice {
    margin-bottom: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .notice--success {
    background: var(--color-success-bg);
    color: var(--color-success-text);
    border-color: color-mix(in oklch, var(--color-success) 40%, transparent);
  }

  .notice--error {
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
    border-color: color-mix(in oklch, var(--color-danger) 40%, transparent);
  }

  .forbidden,
  .empty {
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .empty h2 {
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .moderation-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: var(--space-3);
    align-items: start;
  }

  .queue {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .queue-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .queue-item:last-child {
    border-bottom: 0;
  }

  .queue-item:hover,
  .queue-item.is-active {
    background: var(--color-surface-sunken);
  }

  .queue-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .queue-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .queue-title strong {
    overflow: hidden;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .queue-meta,
  .queue-id {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .queue-id {
    flex: none;
    font-family: var(--font-mono);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .review__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    flex-wrap: wrap;
  }

  .review__meta a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .review__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .review__checks {
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .review__checks h3 {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .review__clear {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-success-text);
    font-size: var(--text-xs);
  }

  .review__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding-left: var(--space-4);
    font-size: var(--text-xs);
  }

  .review__list--blocking {
    color: var(--color-danger-text);
  }

  .review__list--warnings {
    margin-top: var(--space-2);
    color: var(--color-warning-text);
  }

  .review__form,
  .review__reject {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .field span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .field select,
  .field textarea {
    width: 100%;
    padding: var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .review__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  @media (max-width: 1000px) {
    .moderation-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
