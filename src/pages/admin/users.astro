---
import { ShieldCheck, UserCog } from '@lucide/astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { getAdministratorAccess } from '../../lib/admin-auth';
import { getPrisma } from '../../db/prisma';
import { roleLabels } from '../../lib/permissions';

export const prerender = false;

const { user, allowed } = await getAdministratorAccess(Astro);
if (!user) {
  return Astro.redirect(`/sign-in?redirectTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const roles = ['MEMBER', 'TRUSTED_CREATOR', 'MODERATOR', 'ADMINISTRATOR'] as const;
let errorMessage: string | null = null;

if (allowed && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const userId = String(form.get('userId') ?? '');
  const role = String(form.get('role') ?? '');
  const reason = String(form.get('reason') ?? '').trim();

  if (intent === 'set-role' && roles.includes(role as never) && userId && reason.length >= 3) {
    const profile = await getPrisma().memberProfile.findUnique({ where: { userId } });
    if (profile) {
      await getPrisma().$transaction(async (tx) => {
        await tx.memberProfile.update({
          where: { userId },
          data: {
            role: role as (typeof roles)[number],
            trustedCreator: role === 'TRUSTED_CREATOR' || role === 'ADMINISTRATOR',
          },
        });
        await tx.auditEvent.create({
          data: {
            actorId: user.id,
            actorEmail: user.email,
            action: 'user.role_changed',
            entityType: 'member_profile',
            entityId: userId,
            summary: `Changed ${profile.username} from ${profile.role} to ${role}`,
            metadata: { before: profile.role, after: role, reason },
          },
        });
      });
      return Astro.redirect('/admin/users?notice=role');
    }
  }
  errorMessage = 'Choose a role and add a reason of at least 3 characters.';
}

const profiles = allowed
  ? await getPrisma().memberProfile.findMany({
      orderBy: [{ role: 'desc' }, { createdAt: 'asc' }],
      include: {
        _count: { select: { templates: true, trips: true } },
      },
    })
  : [];

const notice = Astro.url.searchParams.get('notice');
---

<AdminLayout title="Users">
  <PageHeader
    title="People and roles"
    description="Roles are enforced on the server. UI navigation only reflects what the API will allow."
  >
    <Badge variant="info" dot>{profiles.length} profiles</Badge>
  </PageHeader>

  {notice === 'role' && <p class="notice notice--success" role="status">Role updated and audited.</p>}
  {errorMessage && <p class="notice notice--error" role="alert">{errorMessage}</p>}

  {!allowed ? (
    <p class="forbidden" role="alert">Administrator access required.</p>
  ) : (
    <div class="user-list">
      {profiles.map((profile) => (
        <article class="user-row">
          <div class="user-copy">
            <div class="user-head">
              <strong>{profile.displayName}</strong>
              <span>@{profile.username}</span>
              <Badge
                variant={
                  profile.role === 'ADMINISTRATOR'
                    ? 'danger'
                    : profile.role === 'MODERATOR'
                      ? 'warning'
                      : profile.role === 'TRUSTED_CREATOR'
                        ? 'success'
                        : 'neutral'
                }
                dot
              >
                {roleLabels[profile.role]}
              </Badge>
              {profile.suspendedAt && <Badge variant="danger">Suspended</Badge>}
            </div>
            <p class="user-meta">
              {profile._count.templates} templates · {profile._count.trips} trips · joined{' '}
              {profile.createdAt.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })}
              {profile.trustedCreator ? ' · trusted publishing flag on' : ''}
            </p>
          </div>

          <form method="post" class="role-form">
            <input type="hidden" name="intent" value="set-role" />
            <input type="hidden" name="userId" value={profile.userId} />
            <label>
              <span>Role</span>
              <select name="role" aria-label={`Role for ${profile.displayName}`}>
                {roles.map((role) => (
                  <option value={role} selected={profile.role === role}>{roleLabels[role]}</option>
                ))}
              </select>
            </label>
            <label>
              <span>Reason</span>
              <input name="reason" required minlength="3" maxlength="300" placeholder="Why is this changing?" />
            </label>
            <Button type="submit" variant="secondary" size="sm">
              <UserCog size={14} stroke-width={1.75} />
              Update
            </Button>
          </form>
        </article>
      ))}
    </div>
  )}

  <p class="permission-note">
    <ShieldCheck size={13} stroke-width={1.75} />
    Permission matrix: members can plan trips; trusted creators can publish directly; moderators review
    templates and reports; administrators manage roles, competitions, rewards, and the audit log.
  </p>
</AdminLayout>

<style>
  .notice {
    margin-bottom: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .notice--success {
    background: var(--color-success-bg);
    color: var(--color-success-text);
    border-color: color-mix(in oklch, var(--color-success) 40%, transparent);
  }

  .notice--error {
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
    border-color: color-mix(in oklch, var(--color-danger) 40%, transparent);
  }

  .forbidden {
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .user-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .user-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .user-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .user-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .user-head strong {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .user-head span {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .user-meta {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .role-form {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .role-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .role-form label span {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .role-form select,
  .role-form input {
    height: var(--control-height-sm);
    padding: 0 var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .role-form input {
    width: 12rem;
  }

  .permission-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  @media (max-width: 900px) {
    .user-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
