---
import PublicPage from '../components/public/PublicPage.astro';
import AuthCard from '../components/public/AuthCard.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import { getAuthForRequest } from '../lib/auth-server';

export const prerender = false;

let errorMessage: string | null = null;
let sent = false;
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();

  if (!email) {
    errorMessage = 'Enter the email address for your account.';
  } else {
    const auth = getAuthForRequest(Astro);
    const origin = new URL(Astro.request.url).origin;
    await auth.requestPasswordReset({
      email,
      redirectTo: `${origin}/reset-password`,
    });
    sent = true;
  }
}
---

<PublicPage
  label="Account"
  title="Reset your password"
  description="Enter the email address on your account. If it exists, we will send a reset link."
  noindex
>
  <AuthCard error={errorMessage}>
    {sent ? (
      <div class="sent">
        <p>Check your inbox for the password reset link. It may take a minute to arrive.</p>
        <a href="/sign-in">Back to sign in</a>
      </div>
    ) : (
      <form method="post" class="auth-form">
        <Input
          label="Email address"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@example.com"
          value={email}
          required
        />
        <Button type="submit" variant="primary" block>Send reset link</Button>
      </form>
    )}
    <div class="auth-links">
      <a href="/sign-in">Back to sign in</a>
      <a href="/sign-up">Create an account</a>
    </div>
  </AuthCard>
</PublicPage>

<style>
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sent {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .sent a {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .auth-links {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .auth-links a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-text-subtle);
    text-underline-offset: 2px;
  }

  .auth-links a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
