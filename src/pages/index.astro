---
import {
  ArrowRight,
  Check,
  LayoutTemplate,
  MapPin,
  Route,
  Search,
  Sparkles,
  Users,
} from '@lucide/astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import Badge from '../components/ui/Badge.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import DestinationCard from '../components/public/DestinationCard.astro';
import PublicButton from '../components/public/PublicButton.astro';
import { getPrisma } from '../db/prisma';

const stops = [
  { day: 'Day 1', place: 'Angkor Wat', detail: 'Sunrise, then the quiet outer temples' },
  { day: 'Day 2', place: 'Kampot riverside', detail: 'Slow morning, pepper farm, sunset' },
  { day: 'Day 3', place: 'Kep crab market', detail: 'Seafood lunch and the coastal road' },
  { day: 'Day 4', place: 'Koh Rong', detail: 'Boat out, swim, and do very little' },
];

interface DestinationCard {
  name: string;
  slug: string;
  summary: string | null;
  province: string;
  category: string | null;
  image: string;
  alt: string;
}

interface CollectionCard {
  title: string;
  slug: string;
  description: string | null;
  destinations: string[];
}

const origin = Astro.url.origin;
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tosder Communities',
  url: new URL('/', origin).toString(),
  description:
    'Discover Cambodia, create reusable itineraries, and share travel templates.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${origin}/explore?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

let destinations: DestinationCard[] = [];
let collections: CollectionCard[] = [];

try {
  const prisma = getPrisma();
  const [destinationRows, collectionRows] = await Promise.all([
    prisma.destination.findMany({
      where: { status: 'PUBLISHED' },
      orderBy: [{ sortOrder: 'asc' }, { name: 'asc' }],
      take: 6,
      include: {
        province: { select: { name: true } },
        photos: {
          orderBy: { sortOrder: 'asc' },
          take: 1,
          select: { url: true, alt: true },
        },
        categories: {
          take: 1,
          include: { category: { select: { name: true } } },
        },
      },
    }),
    prisma.featuredCollection.findMany({
      where: { status: 'PUBLISHED' },
      orderBy: { sortOrder: 'asc' },
      take: 2,
      include: {
        items: {
          orderBy: { sortOrder: 'asc' },
          include: { destination: { select: { name: true } } },
        },
      },
    }),
  ]);

  destinations = destinationRows.map((destination) => ({
    name: destination.name,
    slug: destination.slug,
    summary: destination.summary,
    province: destination.province.name,
    category: destination.categories[0]?.category.name ?? null,
    image:
      destination.coverPhotoUrl ??
      destination.photos[0]?.url ??
      '/image/placeholder-destination.svg',
    alt: destination.photos[0]?.alt ?? destination.name,
  }));

  collections = collectionRows.map((collection) => ({
    title: collection.title,
    slug: collection.slug,
    description: collection.description,
    destinations: collection.items.map((item) => item.destination.name),
  }));
} catch {
  destinations = [];
  collections = [];
}
---

<PublicLayout
  title="Tosder Communities — Cambodia travel, planned well"
  canonical="/"
  image="/image/og-default.png"
  imageAlt="Tosder Communities — Cambodia travel, planned by people who have been there."
  jsonLd={homeJsonLd}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="label">Community travel plans</p>
        <h1>Cambodia, planned by people who have been there.</h1>
        <p class="lede">
          Discover places worth the detour, copy an itinerary that already works,
          and make it yours. When someone uses your plan, you get the credit.
        </p>
        <div class="actions">
          <a class="button button--primary" href="/explore">
            Explore destinations
            <ArrowRight size={15} stroke-width={2} />
          </a>
          <a class="button button--secondary" href="/templates">Browse templates</a>
        </div>

        <form class="hero-search" action="/explore" method="get" role="search">
          <Search size={15} stroke-width={1.75} aria-hidden="true" />
          <input
            type="search"
            name="q"
            placeholder="Search a province, place, or route…"
            aria-label="Search destinations"
            autocomplete="off"
          />
          <button type="submit">Search</button>
        </form>

        <p class="fine-print">Free to browse. Templates are created and shared by travelers.</p>
      </div>

      <aside class="route-card" aria-label="Example travel template">
        <div class="route-card__header">
          <div>
            <p class="route-card__kicker">A four-day route</p>
            <h2>Siem Reap to the coast</h2>
          </div>
          <Badge variant="success" dot>Published</Badge>
        </div>
        <ol class="route-list">
          {stops.map((stop, index) => (
            <li class="route-stop">
              <span class="route-stop__marker" aria-hidden="true">
                <span class="route-stop__dot"></span>
              </span>
              <span class="route-stop__copy">
                <span class="route-stop__day">{stop.day}</span>
                <strong>{stop.place}</strong>
                <span>{stop.detail}</span>
              </span>
              {index === 0 && <MapPin class="route-stop__icon" size={15} stroke-width={1.75} aria-hidden="true" />}
            </li>
          ))}
        </ol>
        <div class="route-card__footer">
          <div class="route-stats">
            <span class="avatar-stack" aria-hidden="true">
              <span>SM</span><span>DL</span><span>VH</span>
            </span>
            <span><strong>184</strong> travelers used this plan</span>
          </div>
          <a href="/templates">View template <ArrowRight size={13} stroke-width={1.75} /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="places-heading">
    <div class="container">
      <div class="section__intro section__intro--row">
        <div>
          <p class="label">Places to start with</p>
          <h2 id="places-heading">A few good places to begin.</h2>
        </div>
        <a class="section-link" href="/explore">
          Explore all destinations
          <ArrowRight size={14} stroke-width={1.75} />
        </a>
      </div>

      {destinations.length > 0 ? (
        <div class="destination-grid">
          {destinations.map((destination) => (
            <DestinationCard destination={destination} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="The destination catalog is being prepared"
          description="Reviewed places, coordinates, and practical notes will appear here as the content milestone lands."
        >
          <MapPin slot="icon" size={20} stroke-width={1.75} />
          <PublicButton href="/status">Check system status</PublicButton>
        </EmptyState>
      )}
    </div>
  </section>

  <section class="section section--routes" aria-labelledby="routes-heading">
    <div class="container routes-grid">
      <div class="routes-copy">
        <p class="label">Editorial routes</p>
        <h2 id="routes-heading">Start with a shape, then make it yours.</h2>
        <p>
          Collections group a few places that work well together. Copy a route,
          change the dates, and keep the parts that fit your trip.
        </p>
      </div>

      <div class="collection-list">
        {collections.length > 0 ? (
          collections.map((collection) => (
            <a class="collection-card" href={`/explore?collection=${collection.slug}`}>
              <div class="collection-card__header">
                <h3>{collection.title}</h3>
                <ArrowRight size={15} stroke-width={1.75} aria-hidden="true" />
              </div>
              {collection.description && <p>{collection.description}</p>}
              <span>{collection.destinations.join(' · ')}</span>
            </a>
          ))
        ) : (
          <EmptyState
            title="Collections are on the way"
            description="Editorial routes will appear here after the destination catalog is reviewed."
          />
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__intro">
        <p class="label">A better starting point</p>
        <h2>Skip the blank page. Start with a plan that has already been walked.</h2>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step__number">01</span>
          <div class="step__icon" aria-hidden="true"><MapPin size={17} stroke-width={1.75} /></div>
          <h3>Discover places with context</h3>
          <p>Province, season, practical tips, and the nearby stops that make a route work.</p>
        </article>
        <article class="step">
          <span class="step__number">02</span>
          <div class="step__icon" aria-hidden="true"><Route size={17} stroke-width={1.75} /></div>
          <h3>Copy a template into your trip</h3>
          <p>Your copy is private and editable. The creator's original plan never changes.</p>
        </article>
        <article class="step">
          <span class="step__number">03</span>
          <div class="step__icon" aria-hidden="true"><Sparkles size={17} stroke-width={1.75} /></div>
          <h3>Make it yours and share what worked</h3>
          <p>Adjust dates, swap stops, and publish your own version when it is ready.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--trust">
    <div class="container trust-grid">
      <div class="trust-copy">
        <p class="label">Built on trust</p>
        <h2>Useful plans deserve attention. Not inflated numbers.</h2>
        <p>
          Views are not uses. Saves are not uses. Only a trip someone actually
          creates and keeps counts toward a creator's results. The original plan
          stays intact, and every copy keeps its source.
        </p>
      </div>
      <ul class="trust-list">
        <li><Check size={16} stroke-width={2} aria-hidden="true" /> One qualified use per traveler, template, and month</li>
        <li><Check size={16} stroke-width={2} aria-hidden="true" /> Creators see aggregate performance, never private trip details</li>
        <li><Check size={16} stroke-width={2} aria-hidden="true" /> Monthly Top 5 rewards follow published, audited rules</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="next-heading">
    <div class="container">
      <div class="section__intro">
        <p class="label">Coming next</p>
        <h2 id="next-heading">The first templates and creator profiles are being prepared.</h2>
      </div>
      <div class="two-up">
        <EmptyState
          title="The first reviewed templates are on the way"
          description="Creators can draft itineraries in the admin preview. Public publishing opens after the creator workflow and moderation pass."
        >
          <LayoutTemplate slot="icon" size={20} stroke-width={1.75} />
          <PublicButton href="/templates" variant="secondary">See the template page</PublicButton>
        </EmptyState>
        <EmptyState
          title="Creator profiles appear with the first published templates"
          description="Every public plan credits its creator. One account is both traveler and creator."
        >
          <Users slot="icon" size={20} stroke-width={1.75} />
          <PublicButton href="/sign-up">Become a creator</PublicButton>
        </EmptyState>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band">
      <div>
        <p class="label">Start with a real route</p>
        <h2>Find your next few days in Cambodia.</h2>
      </div>
      <div class="actions">
        <a class="button button--primary" href="/explore">Explore destinations</a>
        <a class="button button--secondary" href="/templates">See travel templates</a>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .container {
    width: min(100% - var(--space-8), 72rem);
    margin: 0 auto;
  }

  .label {
    margin-bottom: var(--space-3);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .hero {
    padding: clamp(var(--space-10), 10vw, 7rem) 0 clamp(var(--space-10), 8vw, 6rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(var(--space-8), 7vw, 6rem);
    align-items: center;
  }

  h1 {
    max-width: 15ch;
    margin-bottom: var(--space-4);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .lede {
    max-width: 55ch;
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--control-height-lg);
    padding: 0 var(--space-4);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .button--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .button--primary:hover {
    background: var(--color-accent-hover);
  }

  .button--secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .button--secondary:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  .fine-print {
    margin-top: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .hero-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: min(100%, 28rem);
    height: var(--control-height-lg);
    margin-top: var(--space-5);
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-subtle);
  }

  .hero-search:focus-within {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-focus) 20%, transparent);
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-size: var(--text-sm);
    outline: none;
  }

  .hero-search input::placeholder {
    color: var(--color-text-subtle);
  }

  .hero-search button {
    height: 1.75rem;
    padding: 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .section__intro--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    max-width: none;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    flex: none;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .section-link:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .destination-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .destination-card {
    display: flex;
    flex-direction: column;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .destination-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .destination-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-surface-sunken);
    overflow: hidden;
  }

  .destination-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .destination-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
  }

  .destination-card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .destination-card__body strong {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
  }

  .destination-card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  .section--routes {
    background: var(--color-bg-subtle);
  }

  .routes-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
    gap: clamp(var(--space-8), 6vw, 5rem);
    align-items: start;
  }

  .routes-copy p:not(.label) {
    max-width: 50ch;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .collection-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .collection-card:hover {
    border-color: var(--color-border-strong);
  }

  .collection-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .collection-card__header h3 {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .collection-card__header svg {
    color: var(--color-text-subtle);
  }

  .collection-card p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .collection-card > span {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .two-up {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .route-card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .route-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .route-card__kicker {
    margin-bottom: var(--space-1);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .route-card h2 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.03em;
  }

  .route-list {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    list-style: none;
  }

  .route-stop {
    position: relative;
    display: flex;
    gap: var(--space-3);
    padding: 0 0 var(--space-4);
  }

  .route-stop:last-child {
    padding-bottom: 0;
  }

  .route-stop__marker {
    position: relative;
    display: flex;
    justify-content: center;
    width: 0.75rem;
    flex: none;
  }

  .route-stop__marker::after {
    position: absolute;
    top: 0.75rem;
    bottom: calc(var(--space-4) * -1);
    width: 1px;
    background: var(--color-border);
    content: '';
  }

  .route-stop:last-child .route-stop__marker::after {
    display: none;
  }

  .route-stop__dot {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.3rem;
    border: 2px solid var(--color-bg);
    border-radius: var(--radius-full);
    background: var(--chart-3);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .route-stop__copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .route-stop__day {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .route-stop__copy strong {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }

  .route-stop__copy > span:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .route-stop__icon {
    margin-left: auto;
    color: var(--color-text-subtle);
  }

  .route-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .route-stats {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .route-stats strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .avatar-stack {
    display: flex;
  }

  .avatar-stack span {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-left: -0.25rem;
    border: 2px solid var(--color-bg-subtle);
    border-radius: var(--radius-full);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .avatar-stack span:first-child {
    margin-left: 0;
  }

  .route-card__footer a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text);
    white-space: nowrap;
  }

  .route-card__footer a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .section {
    padding: clamp(var(--space-9), 7vw, 5rem) 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .section__intro {
    max-width: 62ch;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

