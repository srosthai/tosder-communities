---
import { ArrowRight, Check, MapPin, Route, Sparkles } from '@lucide/astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import Badge from '../components/ui/Badge.astro';

const stops = [
  { day: 'Day 1', place: 'Angkor Wat', detail: 'Sunrise, then the quiet outer temples' },
  { day: 'Day 2', place: 'Kampot riverside', detail: 'Slow morning, pepper farm, sunset' },
  { day: 'Day 3', place: 'Kep crab market', detail: 'Seafood lunch and the coastal road' },
  { day: 'Day 4', place: 'Koh Rong', detail: 'Boat out, swim, and do very little' },
];
---

<PublicLayout title="Tosder Communities — Cambodia travel, planned well">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="label">Community travel plans</p>
        <h1>Cambodia, planned by people who have been there.</h1>
        <p class="lede">
          Discover places worth the detour, copy an itinerary that already works,
          and make it yours. When someone uses your plan, you get the credit.
        </p>
        <div class="actions">
          <a class="button button--primary" href="/explore">
            Explore destinations
            <ArrowRight size={15} stroke-width={2} />
          </a>
          <a class="button button--secondary" href="/templates">Browse templates</a>
        </div>
        <p class="fine-print">Free to browse. Templates are created and shared by travelers.</p>
      </div>

      <aside class="route-card" aria-label="Example travel template">
        <div class="route-card__header">
          <div>
            <p class="route-card__kicker">A four-day route</p>
            <h2>Siem Reap to the coast</h2>
          </div>
          <Badge variant="success" dot>Published</Badge>
        </div>
        <ol class="route-list">
          {stops.map((stop, index) => (
            <li class="route-stop">
              <span class="route-stop__marker" aria-hidden="true">
                <span class="route-stop__dot"></span>
              </span>
              <span class="route-stop__copy">
                <span class="route-stop__day">{stop.day}</span>
                <strong>{stop.place}</strong>
                <span>{stop.detail}</span>
              </span>
              {index === 0 && <MapPin class="route-stop__icon" size={15} stroke-width={1.75} aria-hidden="true" />}
            </li>
          ))}
        </ol>
        <div class="route-card__footer">
          <div class="route-stats">
            <span class="avatar-stack" aria-hidden="true">
              <span>SM</span><span>DL</span><span>VH</span>
            </span>
            <span><strong>184</strong> travelers used this plan</span>
          </div>
          <a href="/templates">View template <ArrowRight size={13} stroke-width={1.75} /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__intro">
        <p class="label">A better starting point</p>
        <h2>Skip the blank page. Start with a plan that has already been walked.</h2>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step__number">01</span>
          <div class="step__icon" aria-hidden="true"><MapPin size={17} stroke-width={1.75} /></div>
          <h3>Discover places with context</h3>
          <p>Province, season, practical tips, and the nearby stops that make a route work.</p>
        </article>
        <article class="step">
          <span class="step__number">02</span>
          <div class="step__icon" aria-hidden="true"><Route size={17} stroke-width={1.75} /></div>
          <h3>Copy a template into your trip</h3>
          <p>Your copy is private and editable. The creator's original plan never changes.</p>
        </article>
        <article class="step">
          <span class="step__number">03</span>
          <div class="step__icon" aria-hidden="true"><Sparkles size={17} stroke-width={1.75} /></div>
          <h3>Make it yours and share what worked</h3>
          <p>Adjust dates, swap stops, and publish your own version when it is ready.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--trust">
    <div class="container trust-grid">
      <div class="trust-copy">
        <p class="label">Built on trust</p>
        <h2>Useful plans deserve attention. Not inflated numbers.</h2>
        <p>
          Views are not uses. Saves are not uses. Only a trip someone actually
          creates and keeps counts toward a creator's results. The original plan
          stays intact, and every copy keeps its source.
        </p>
      </div>
      <ul class="trust-list">
        <li><Check size={16} stroke-width={2} aria-hidden="true" /> One qualified use per traveler, template, and month</li>
        <li><Check size={16} stroke-width={2} aria-hidden="true" /> Creators see aggregate performance, never private trip details</li>
        <li><Check size={16} stroke-width={2} aria-hidden="true" /> Monthly Top 5 rewards follow published, audited rules</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band">
      <div>
        <p class="label">Start with a real route</p>
        <h2>Find your next few days in Cambodia.</h2>
      </div>
      <div class="actions">
        <a class="button button--primary" href="/explore">Explore destinations</a>
        <a class="button button--secondary" href="/templates">See travel templates</a>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .container {
    width: min(100% - var(--space-8), 72rem);
    margin: 0 auto;
  }

  .label {
    margin-bottom: var(--space-3);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .hero {
    padding: clamp(var(--space-10), 10vw, 7rem) 0 clamp(var(--space-10), 8vw, 6rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(var(--space-8), 7vw, 6rem);
    align-items: center;
  }

  h1 {
    max-width: 15ch;
    margin-bottom: var(--space-4);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .lede {
    max-width: 55ch;
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--control-height-lg);
    padding: 0 var(--space-4);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .button--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .button--primary:hover {
    background: var(--color-accent-hover);
  }

  .button--secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .button--secondary:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  .fine-print {
    margin-top: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .route-card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .route-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .route-card__kicker {
    margin-bottom: var(--space-1);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .route-card h2 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.03em;
  }

  .route-list {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    list-style: none;
  }

  .route-stop {
    position: relative;
    display: flex;
    gap: var(--space-3);
    padding: 0 0 var(--space-4);
  }

  .route-stop:last-child {
    padding-bottom: 0;
  }

  .route-stop__marker {
    position: relative;
    display: flex;
    justify-content: center;
    width: 0.75rem;
    flex: none;
  }

  .route-stop__marker::after {
    position: absolute;
    top: 0.75rem;
    bottom: calc(var(--space-4) * -1);
    width: 1px;
    background: var(--color-border);
    content: '';
  }

  .route-stop:last-child .route-stop__marker::after {
    display: none;
  }

  .route-stop__dot {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.3rem;
    border: 2px solid var(--color-bg);
    border-radius: var(--radius-full);
    background: var(--chart-3);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .route-stop__copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .route-stop__day {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .route-stop__copy strong {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }

  .route-stop__copy > span:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .route-stop__icon {
    margin-left: auto;
    color: var(--color-text-subtle);
  }

  .route-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .route-stats {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .route-stats strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .avatar-stack {
    display: flex;
  }

  .avatar-stack span {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-left: -0.25rem;
    border: 2px solid var(--color-bg-subtle);
    border-radius: var(--radius-full);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .avatar-stack span:first-child {
    margin-left: 0;
  }

  .route-card__footer a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text);
    white-space: nowrap;
  }

  .route-card__footer a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .section {
    padding: clamp(var(--space-9), 7vw, 5rem) 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .section__intro {
    max-width: 62ch;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .step__number {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .step__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  .step h3 {
    margin-top: var(--space-1);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .step p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .section--trust {
    background: var(--color-bg-subtle);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.9fr);
    gap: clamp(var(--space-8), 6vw, 5rem);
    align-items: start;
  }

  .trust-copy p:not(.label) {
    max-width: 55ch;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .trust-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .trust-list svg {
    flex: none;
    margin-top: 2px;
    color: var(--chart-3);
  }

  .cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-8);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-subtle);
  }

  .cta-band .label {
    margin-bottom: var(--space-2);
  }

  @media (max-width: 960px) {
    .hero__grid,
    .trust-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .route-card {
      max-width: 32rem;
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .cta-band {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .button {
      width: 100%;
    }

    .route-card__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
