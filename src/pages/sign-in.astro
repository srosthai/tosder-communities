---
import AuthShell from '../components/public/AuthShell.astro';
import { getAuthForRequest, safeRedirect, startSocialSignIn } from '../lib/auth-server';
import { getSessionUser } from '../lib/auth-user';

export const prerender = false;

const queryError = Astro.url.searchParams.get('error');
let errorMessage: string | null =
  Astro.url.searchParams.get('deleted') === '1'
    ? 'This account has been deleted. Create a new account to continue.'
    : queryError === 'google'
      ? 'Google sign-in could not be completed. Try again or use email.'
      : null;
let email = '';
const redirectTo = safeRedirect(
  Astro.url.searchParams.get('redirectTo') ?? '/account',
);

const auth = getAuthForRequest(Astro);
const existingUser = await getSessionUser(Astro);

if (existingUser && Astro.request.method !== 'POST') {
  return Astro.redirect(redirectTo);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'email');
  const target = safeRedirect(form.get('redirectTo') ?? redirectTo);

  if (intent === 'google') {
    const result = await startSocialSignIn(
      Astro,
      'google',
      new URL(target, Astro.url.origin).toString(),
    );
    if (result.url) return Astro.redirect(result.url);
    errorMessage = result.error ?? 'Google sign-in could not be started.';
  } else {
    email = String(form.get('email') ?? '').trim();
    const password = String(form.get('password') ?? '');

    if (!email || !password) {
      errorMessage = 'Enter your email and password.';
    } else {
      const result = await auth.signIn.email({ email, password });
      if (result.error) {
        errorMessage =
          result.error.message === 'Invalid email or password'
            ? 'That email and password do not match.'
            : result.error.message ?? 'Unable to sign in. Try again.';
      } else {
        return Astro.redirect(target);
      }
    }
  }
}
---

<AuthShell
  title="Welcome back"
  description="Sign in to pick up your trips, saved places, and creator workspace."
  eyebrow="Sign in"
  error={errorMessage}
  alternateText="New to Tosder?"
  alternateHref={`/sign-up?redirectTo=${encodeURIComponent(redirectTo)}`}
  alternateLink="Create an account"
>
  <form method="post" class="auth-social-form">
    <input type="hidden" name="redirectTo" value={redirectTo} />
    <input type="hidden" name="intent" value="google" />
    <button class="auth-social" type="submit">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z"></path>
        <path fill="#34A853" d="M12 22c2.7 0 4.96-.9 6.62-2.43l-3.24-2.51c-.9.6-2.05.96-3.38.96-2.6 0-4.8-1.76-5.59-4.12H3.07v2.59A10 10 0 0 0 12 22Z"></path>
        <path fill="#FBBC05" d="M6.41 13.9a6 6 0 0 1 0-3.8V7.51H3.07a10 10 0 0 0 0 8.98l3.34-2.59Z"></path>
        <path fill="#EA4335" d="M12 5.98c1.47 0 2.79.5 3.82 1.5l2.87-2.87A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.93 5.51l3.34 2.59C7.2 7.74 9.4 5.98 12 5.98Z"></path>
      </svg>
      Continue with Google
    </button>
  </form>

  <div class="auth-divider"><span>or continue with email</span></div>

  <form method="post" class="auth-form">
    <input type="hidden" name="redirectTo" value={redirectTo} />
    <input type="hidden" name="intent" value="email" />

    <label class="auth-field">
      <span>Email address</span>
      <input
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="you@example.com"
        value={email}
        required
      />
    </label>

    <label class="auth-field">
      <span class="auth-field__row">
        <span>Password</span>
        <a href="/forgot-password">Forgot password?</a>
      </span>
      <input
        name="password"
        type="password"
        aria-label="Password"
        autocomplete="current-password"
        placeholder="Your password"
        required
      />
    </label>

    <button class="auth-submit" type="submit">Sign in</button>
  </form>
</AuthShell>

<style>
  .auth-social-form,
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .auth-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    height: 2.75rem;
    padding: 0 var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .auth-social:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-sunken);
  }

  .auth-social:focus-visible,
  .auth-submit:focus-visible,
  .auth-field input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-4) 0;
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    height: 1px;
    flex: 1;
    background: var(--color-border);
  }

  .auth-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .auth-field > span,
  .auth-field__row {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .auth-field__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .auth-field__row a {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .auth-field input {
    width: 100%;
    height: 2.75rem;
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-md);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .auth-field input::placeholder {
    color: var(--color-text-subtle);
  }

  .auth-field input:focus {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-focus) 16%, transparent);
  }

  .auth-submit {
    width: 100%;
    height: 2.75rem;
    margin-top: var(--space-1);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .auth-submit:hover {
    background: var(--color-accent-hover);
  }
</style>
