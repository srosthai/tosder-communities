---
import {
  ArrowLeft,
  ArrowRight,
  ChevronDown,
  ChevronUp,
  CircleAlert,
  CircleCheck,
  Clock,
  Copy,
  MapPin,
  Plus,
  Trash,
} from '@lucide/astro';
import { z } from 'zod';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Checkbox from '../../../components/ui/Checkbox.astro';
import Input from '../../../components/ui/Input.astro';
import MapView from '../../../components/public/MapView.astro';
import Select from '../../../components/ui/Select.astro';
import Textarea from '../../../components/ui/Textarea.astro';
import { getPrisma } from '../../../db/prisma';
import { ApiError, json } from '../../../lib/api';
import { getSessionUser } from '../../../lib/auth-user';
import { ensureMemberProfile } from '../../../lib/profiles';
import { getCreatorTemplate, submitTemplateForReview, templateStatusMeta } from '../../../lib/templates';
import {
  audienceOptions,
  builderSteps,
  createDay,
  createItem,
  duplicateDay,
  duplicateItem,
  findScheduleConflicts,
  formatMoney,
  formatTimeRange,
  getStepErrors,
  getTemplateProgress,
  itemTypeLabels,
  moveDay,
  moveItem,
  parseBuilderStep,
  parseInteger,
  parseMoney,
  parseTime,
  removeDay,
  removeItem,
  saveTemplateMetadata,
  templateStyles,
  transportOptions,
  updateDay,
  updateItem,
  validateTemplate,
  type BuilderStep,
  type BuilderTemplate,
} from '../../../lib/template-builder';

export const prerender = false;

const user = await getSessionUser(Astro);
if (!user) {
  return Astro.redirect(
    `/sign-in?redirectTo=${encodeURIComponent(Astro.url.pathname)}`,
  );
}

await ensureMemberProfile(user);
const id = z.uuid().safeParse(Astro.params.id);

if (!id.success) {
  Astro.response.status = 404;
}

let template = id.success
  ? ((await getCreatorTemplate(id.data, user.id)) as BuilderTemplate | null)
  : null;

if (!template) {
  Astro.response.status = 404;
}

const step = parseBuilderStep(Astro.url.searchParams.get('step'));
const isAutosave = Astro.request.headers.get('x-autosave') === '1';
let errorMessage: string | null = Astro.url.searchParams.get('error')?.slice(0, 200) ?? null;

const saveResponse = () =>
  json({ ok: true, savedAt: new Date().toISOString() });

if (template && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const value = (name: string) => String(form.get(name) ?? '').trim();
  const nullable = (name: string) => value(name) || null;
  const nextStep = String(form.get('next') ?? step);

  try {
    switch (intent) {
      case 'save-basics': {
        await saveTemplateMetadata(template.id, user.id, {
          title: value('title'),
          slug: value('slug'),
          summary: nullable('summary'),
          description: nullable('description'),
          coverPhotoUrl: nullable('coverPhotoUrl'),
          provinceId: value('provinceId') || null,
          language: value('language') || 'en',
        });
        break;
      }
      case 'save-details': {
        await saveTemplateMetadata(template.id, user.id, {
          style: value('style') || null,
          season: nullable('season'),
          budgetMinCents: parseMoney(form.get('budgetMin')),
          budgetMaxCents: parseMoney(form.get('budgetMax')),
          transport: form.getAll('transport').map(String),
          audience: form.getAll('audience').map(String),
        });
        break;
      }
      case 'save-logistics': {
        await saveTemplateMetadata(template.id, user.id, {
          logisticsNotes: nullable('logisticsNotes'),
        });
        break;
      }
      case 'add-day': {
        const day = await createDay(template.id, user.id);
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&day=${day.id}&saved=1`);
      }
      case 'update-day': {
        await updateDay(template.id, user.id, value('dayId'), {
          title: value('title'),
          summary: nullable('summary'),
        });
        break;
      }
      case 'move-day': {
        await moveDay(template.id, user.id, value('dayId'), value('direction') === 'up' ? 'up' : 'down');
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&saved=1`);
      }
      case 'duplicate-day': {
        await duplicateDay(template.id, user.id, value('dayId'));
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&saved=1`);
      }
      case 'remove-day': {
        await removeDay(template.id, user.id, value('dayId'));
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&saved=1`);
      }
      case 'add-item': {
        const item = await createItem(template.id, user.id, value('dayId'));
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&day=${value('dayId')}&item=${item.id}&saved=1`);
      }
      case 'update-item': {
        const type = value('type');
        const allowedTypes = Object.keys(itemTypeLabels) as Array<keyof typeof itemTypeLabels>;
        await updateItem(template.id, user.id, value('dayId'), value('itemId'), {
          title: value('title'),
          type: allowedTypes.includes(type as never)
            ? (type as keyof typeof itemTypeLabels)
            : 'ATTRACTION',
          destinationId: value('destinationId') || null,
          description: nullable('description'),
          practicalTips: nullable('practicalTips'),
          startTime: parseTime(form.get('startTime')),
          endTime: parseTime(form.get('endTime')),
          durationMinutes: parseInteger(form.get('durationMinutes')),
          estimatedCostCents: parseMoney(form.get('estimatedCost')),
          photoUrl: nullable('photoUrl'),
        });
        break;
      }
      case 'move-item': {
        await moveItem(
          template.id,
          user.id,
          value('dayId'),
          value('itemId'),
          value('direction') === 'up' ? 'up' : 'down',
        );
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&day=${value('dayId')}&saved=1`);
      }
      case 'duplicate-item': {
        await duplicateItem(template.id, user.id, value('dayId'), value('itemId'));
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&day=${value('dayId')}&saved=1`);
      }
      case 'remove-item': {
        await removeItem(template.id, user.id, value('dayId'), value('itemId'));
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=plan&day=${value('dayId')}&saved=1`);
      }
      case 'submit-review': {
        if (value('guidelines') !== 'on') {
          throw new ApiError({
            status: 422,
            code: 'guidelines_required',
            message: 'Confirm the community guidelines before submitting.',
          });
        }
        const refreshed = (await getCreatorTemplate(template.id, user.id)) as BuilderTemplate;
        const validation = validateTemplate(refreshed, {
          emailVerified: Boolean(user.emailVerified),
          status: refreshed.status,
        });
        if (validation.blocking.length > 0) {
          throw new ApiError({
            status: 422,
            code: 'validation_error',
            message: 'Fix the blocking issues before submitting for review.',
          });
        }
        await submitTemplateForReview(template.id, user.id, {
          id: user.id,
          email: user.email,
        });
        if (isAutosave) return saveResponse();
        return Astro.redirect(`/creator/templates/${template.id}?step=publish&submitted=1`);
      }
      default:
        break;
    }

    if (isAutosave) return saveResponse();

    template = (await getCreatorTemplate(template.id, user.id)) as BuilderTemplate;
    const stepErrors = getStepErrors(template, step);
    if (stepErrors.length > 0 && nextStep !== step) {
      return Astro.redirect(
        `/creator/templates/${template.id}?step=${step}&error=${encodeURIComponent(stepErrors[0])}`,
      );
    }
    if (nextStep !== step) {
      return Astro.redirect(`/creator/templates/${template.id}?step=${nextStep}&saved=1`);
    }
    return Astro.redirect(`/creator/templates/${template.id}?step=${step}&saved=1`);
  } catch (error) {
    if (isAutosave) {
      const message = error instanceof ApiError ? error.message : 'Could not save.';
      return json({ ok: false, error: message }, error instanceof ApiError ? error.status : 500);
    }
    const message = error instanceof ApiError ? error.message : 'The change could not be saved.';
    return Astro.redirect(
      `/creator/templates/${template.id}?step=${step}&error=${encodeURIComponent(message)}`,
    );
  }
}

const progress = template ? getTemplateProgress(template) : null;
const completedCount = progress
  ? Object.values(progress).filter(Boolean).length
  : 0;
const saved = Astro.url.searchParams.get('saved') === '1';
const submitted = Astro.url.searchParams.get('submitted') === '1';
const activeDay = Astro.url.searchParams.get('day');
const activeItem = Astro.url.searchParams.get('item');

const provinces = await getPrisma().province.findMany({
  where: { status: 'PUBLISHED' },
  orderBy: { name: 'asc' },
  select: { id: true, name: true },
});

const destinations = await getPrisma().destination.findMany({
  where: { status: 'PUBLISHED' },
  orderBy: { name: 'asc' },
  select: {
    id: true,
    name: true,
    province: { select: { name: true } },
  },
});

const validation = template
  ? validateTemplate(template, {
      emailVerified: Boolean(user.emailVerified),
      status: template.status,
    })
  : { blocking: [], warnings: [] };

const mapPoints = template
  ? Array.from(
      new Map(
        template.days
          .flatMap((day) => day.items)
          .filter((item) => item.destination?.latitude != null && item.destination?.longitude != null)
          .map((item) => [
            item.destination!.slug,
            {
              name: item.destination!.name,
              slug: item.destination!.slug,
              province: item.destination!.province?.name ?? 'Cambodia',
              latitude: item.destination!.latitude,
              longitude: item.destination!.longitude,
            },
          ]),
      ).values(),
    )
  : [];

const statusMeta = template ? templateStatusMeta[template.status] : null;

const stepHref = (key: BuilderStep) =>
  `/creator/templates/${template?.id}?step=${key}`;

---

{template && statusMeta ? (
  <PublicLayout
    title={`${template.title || 'Untitled template'} — Creator Studio`}
    description="Build a reusable travel itinerary."
    noindex
  >
    <section class="builder">
      <div class="container">
        <header class="builder__header">
          <div class="builder__identity">
            <a class="back-link" href="/creator">
              <ArrowLeft size={14} stroke-width={1.75} />
              Creator Studio
            </a>
            <h1>{template.title || 'Untitled template'}</h1>
            <div class="builder__meta">
              <Badge variant={statusMeta.variant} dot>{statusMeta.label}</Badge>
              <span>{template.durationDays} {template.durationDays === 1 ? 'day' : 'days'}</span>
              <span>Updated {template.updatedAt.toLocaleDateString('en', { month: 'short', day: 'numeric' })}</span>
            </div>
          </div>
          <div class="builder__save">
            <span data-save-state aria-live="polite">Saved</span>
            <a class="preview-link" href={stepHref('preview')}>
              Preview
              <ArrowRight size={13} stroke-width={2} />
            </a>
          </div>
        </header>

        <div class="builder__progress">
          <div class="builder__progress-bar" aria-hidden="true">
            <span style={`width: ${(completedCount / builderSteps.length) * 100}%`}></span>
          </div>
          <span>{completedCount} of {builderSteps.length} steps complete</span>
        </div>

        <nav class="stepper" aria-label="Template steps">
          {builderSteps.map((entry, index) => (
            <a
              href={stepHref(entry.key)}
              class:list={[
                'stepper__step',
                {
                  'is-current': entry.key === step,
                  'is-complete': progress?.[entry.key],
                },
              ]}
              aria-current={entry.key === step ? 'step' : undefined}
              data-step-link
            >
              <span class="stepper__number">
                {progress?.[entry.key] ? <CircleCheck size={14} stroke-width={2} /> : index + 1}
              </span>
              <span class="stepper__label">
                {entry.label}
                {progress?.[entry.key] && <span class="sr-only">, complete</span>}
              </span>
            </a>
          ))}
        </nav>

        {saved && <p class="notice notice--success" role="status">Step saved.</p>}
        {submitted && (
          <p class="notice notice--success" role="status">
            Submitted for review. You can keep editing until a moderator responds.
          </p>
        )}
        {errorMessage && <p class="notice notice--error" role="alert">{errorMessage}</p>}

        {step === 'basics' && (
          <section class="step" aria-labelledby="step-heading">
            <div class="step__heading">
              <p class="eyebrow">Step 1 of 6</p>
              <h2 id="step-heading">Basics</h2>
              <p>Name the trip, choose the province, and write the short pitch.</p>
            </div>

            <form method="post" data-autosave class="step__form">
              <input type="hidden" name="intent" value="save-basics" />
              <div class="grid">
                <Input label="Title" name="title" value={template.title} maxlength={120} />
                <Input
                  label="Slug"
                  name="slug"
                  value={template.slug}
                  hint="Lowercase words separated by hyphens. Used in the public URL."
                  maxlength={90}
                />
                <Select label="Province" name="provinceId">
                  <option value="">Choose a province</option>
                  {provinces.map((province) => (
                    <option value={province.id} selected={province.id === template.provinceId}>
                      {province.name}
                    </option>
                  ))}
                </Select>
                <Select label="Language" name="language">
                  <option value="en" selected={template.language === 'en'}>English</option>
                  <option value="km" selected={template.language === 'km'}>Khmer</option>
                </Select>
              </div>

              <Input
                label="Summary"
                name="summary"
                value={template.summary ?? ''}
                hint="One or two lines that explain who the trip is for."
                maxlength={400}
              />
              <Textarea
                label="Description"
                name="description"
                value={template.description ?? ''}
                rows={5}
                maxlength={6000}
              />
              <Input
                label="Cover image URL"
                name="coverPhotoUrl"
                value={template.coverPhotoUrl ?? ''}
                hint="Use a licensed image with a recorded credit."
                maxlength={600}
              />

              <div class="derived">
                <Clock size={15} stroke-width={1.75} />
                <span>
                  Duration: <strong>{template.durationDays} {template.durationDays === 1 ? 'day' : 'days'}</strong>.
                  Duration is derived from the daily plan.
                </span>
                <a href={stepHref('plan')} data-step-link>Edit days</a>
              </div>

              <div class="step__actions">
                <button class="primary-action" type="submit" name="next" value="details">
                  Save and continue
                  <ArrowRight size={14} stroke-width={2} />
                </button>
              </div>
            </form>
          </section>
        )}

        {step === 'details' && (
          <section class="step" aria-labelledby="step-heading">
            <div class="step__heading">
              <p class="eyebrow">Step 2 of 6</p>
              <h2 id="step-heading">Trip details</h2>
              <p>Set expectations for budget, season, transport, and who the trip suits.</p>
            </div>

            <form method="post" data-autosave class="step__form">
              <input type="hidden" name="intent" value="save-details" />
              <div class="grid">
                <Select label="Travel style" name="style">
                  <option value="">Choose a style</option>
                  {templateStyles.map((style) => (
                    <option value={style} selected={template.style === style}>{style}</option>
                  ))}
                </Select>
                <Input
                  label="Best season"
                  name="season"
                  value={template.season ?? ''}
                  placeholder="November to March"
                  maxlength={80}
                />
                <Input
                  label="Budget from (USD)"
                  name="budgetMin"
                  type="number"
                  min="0"
                  step="1"
                  value={template.budgetMinCents != null ? template.budgetMinCents / 100 : ''}
                  placeholder="120"
                />
                <Input
                  label="Budget to (USD)"
                  name="budgetMax"
                  type="number"
                  min="0"
                  step="1"
                  value={template.budgetMaxCents != null ? template.budgetMaxCents / 100 : ''}
                  placeholder="300"
                />
              </div>

              <fieldset class="choice-group">
                <legend>Transport</legend>
                <div class="choice-grid">
                  {transportOptions.map((option) => (
                    <Checkbox
                      label={option}
                      name="transport"
                      value={option}
                      checked={template.transport.includes(option)}
                    />
                  ))}
                </div>
              </fieldset>

              <fieldset class="choice-group">
                <legend>Audience</legend>
                <div class="choice-grid">
                  {audienceOptions.map((option) => (
                    <Checkbox
                      label={option}
                      name="audience"
                      value={option}
                      checked={template.audience.includes(option)}
                    />
                  ))}
                </div>
              </fieldset>

              <p class="currency-note">Estimated costs use USD throughout the itinerary.</p>

              <div class="step__actions">
                <button class="secondary-action" type="submit" name="next" value="basics">Back</button>
                <button class="primary-action" type="submit" name="next" value="plan">
                  Save and continue
                  <ArrowRight size={14} stroke-width={2} />
                </button>
              </div>
            </form>
          </section>
        )}

        {step === 'plan' && (
          <section class="step" aria-labelledby="step-heading">
            <div class="step__heading step__heading--split">
              <div>
                <p class="eyebrow">Step 3 of 6</p>
                <h2 id="step-heading">Daily plan</h2>
                <p>Add each day, then fill it with timed stops. Order is explicit, not inferred from time.</p>
              </div>
              <form method="post">
                <input type="hidden" name="intent" value="add-day" />
                <button class="secondary-action" type="submit">
                  <Plus size={14} stroke-width={2} />
                  Add day
                </button>
              </form>
            </div>

            {template.days.length === 0 ? (
              <div class="empty-day">
                <MapPin size={22} stroke-width={1.75} />
                <h3>No days yet.</h3>
                <p>Add day 1 and start with the first stop.</p>
                <form method="post">
                  <input type="hidden" name="intent" value="add-day" />
                  <button class="primary-action" type="submit">
                    <Plus size={14} stroke-width={2} />
                    Add day 1
                  </button>
                </form>
              </div>
            ) : (
              <div class="days">
                {template.days.map((day, dayIndex) => {
                  const conflicts = findScheduleConflicts(day.items);
                  return (
                    <article
                      class:list={['day-card', { 'is-active': activeDay === day.id }]}
                      id={`day-${day.id}`}
                    >
                      <header class="day-card__header">
                        <form method="post" data-autosave class="day-card__title">
                          <input type="hidden" name="intent" value="update-day" />
                          <input type="hidden" name="dayId" value={day.id} />
                          <span class="day-badge">Day {day.dayNumber}</span>
                          <div class="day-card__fields">
                            <label class="sr-only" for={`day-title-${day.id}`}>Day title</label>
                            <input
                              id={`day-title-${day.id}`}
                              name="title"
                              value={day.title ?? ''}
                              placeholder={`Day ${day.dayNumber} title`}
                              maxlength={120}
                            />
                            <label class="sr-only" for={`day-summary-${day.id}`}>Day summary</label>
                            <input
                              id={`day-summary-${day.id}`}
                              name="summary"
                              value={day.summary ?? ''}
                              placeholder="Optional theme for the day"
                              maxlength={300}
                            />
                          </div>
                        </form>

                        <div class="day-card__actions">
                          <form method="post">
                            <input type="hidden" name="intent" value="move-day" />
                            <input type="hidden" name="dayId" value={day.id} />
                            <input type="hidden" name="direction" value="up" />
                            <button class="icon-action" type="submit" aria-label={`Move day ${day.dayNumber} up`} disabled={dayIndex === 0}>
                              <ChevronUp size={14} stroke-width={2} />
                            </button>
                          </form>
                          <form method="post">
                            <input type="hidden" name="intent" value="move-day" />
                            <input type="hidden" name="dayId" value={day.id} />
                            <input type="hidden" name="direction" value="down" />
                            <button class="icon-action" type="submit" aria-label={`Move day ${day.dayNumber} down`} disabled={dayIndex === template.days.length - 1}>
                              <ChevronDown size={14} stroke-width={2} />
                            </button>
                          </form>
                          <form method="post">
                            <input type="hidden" name="intent" value="duplicate-day" />
                            <input type="hidden" name="dayId" value={day.id} />
                            <button class="icon-action" type="submit" aria-label={`Duplicate day ${day.dayNumber}`}>
                              <Copy size={13} stroke-width={1.75} />
                            </button>
                          </form>
                          <form method="post" data-confirm={`Remove day ${day.dayNumber} and all its items?`}>
                            <input type="hidden" name="intent" value="remove-day" />
                            <input type="hidden" name="dayId" value={day.id} />
                            <button class="icon-action icon-action--danger" type="submit" aria-label={`Remove day ${day.dayNumber}`}>
                              <Trash size={13} stroke-width={1.75} />
                            </button>
                          </form>
                        </div>
                      </header>

                      {conflicts.length > 0 && (
                        <div class="conflict" role="status">
                          <CircleAlert size={15} stroke-width={1.75} />
                          <div>
                            {conflicts.map((conflict) => (
                              <p>“{conflict.first}” overlaps “{conflict.second}”.</p>
                            ))}
                            <span>Warnings do not block saving, but check the timing before publishing.</span>
                          </div>
                        </div>
                      )}

                      <div class="items">
                        {day.items.length === 0 && (
                          <p class="items__empty">No stops yet. Add the first activity for this day.</p>
                        )}

                        {day.items.map((item, itemIndex) => (
                          <details class="item" open={activeDay === day.id && (activeItem ? item.id === activeItem : itemIndex === 0)}>
                            <summary class="item__summary">
                              <span class="item__time">{formatTimeRange(item.startTime, item.endTime)}</span>
                              <span class="item__title">{item.title || 'Untitled stop'}</span>
                              <span class="item__type">{itemTypeLabels[item.type]}</span>
                              {item.estimatedCostCents != null && (
                                <span class="item__cost">{formatMoney(item.estimatedCostCents, item.currency)}</span>
                              )}
                            </summary>

                            <form method="post" data-autosave class="item__form">
                              <input type="hidden" name="intent" value="update-item" />
                              <input type="hidden" name="dayId" value={day.id} />
                              <input type="hidden" name="itemId" value={item.id} />

                              <div class="item__grid">
                                <Input label="Title" name="title" value={item.title} maxlength={120} />
                                <Select label="Type" name="type">
                                  {Object.entries(itemTypeLabels).map(([value, label]) => (
                                    <option value={value} selected={item.type === value}>{label}</option>
                                  ))}
                                </Select>
                                <Select label="Linked destination" name="destinationId">
                                  <option value="">Custom activity</option>
                                  {destinations.map((destination) => (
                                    <option value={destination.id} selected={item.destinationId === destination.id}>
                                      {destination.name} · {destination.province?.name ?? 'Cambodia'}
                                    </option>
                                  ))}
                                </Select>
                                <Input label="Photo URL" name="photoUrl" value={item.photoUrl ?? ''} maxlength={600} />
                                <Input label="Start time" name="startTime" type="time" value={item.startTime ?? ''} />
                                <Input label="End time" name="endTime" type="time" value={item.endTime ?? ''} />
                                <Input
                                  label="Duration (minutes)"
                                  name="durationMinutes"
                                  type="number"
                                  min="0"
                                  step="5"
