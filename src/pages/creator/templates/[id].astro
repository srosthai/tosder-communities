<script>
  const state = document.querySelector<HTMLElement>('[data-save-state]');
  const dirty = new Set<HTMLFormElement>();
  const timers = new WeakMap<HTMLFormElement, number>();
  const versions = new WeakMap<HTMLFormElement, number>();
  let pending = 0;

  const setState = (text: string, kind: 'saved' | 'dirty' | 'error' = 'saved') => {
    if (!state) return;
    state.textContent = text;
    state.dataset.state = kind;
  };

  const save = async (form: HTMLFormElement) => {
    if (!dirty.has(form)) return;
    const version = versions.get(form) ?? 0;
    const body = new FormData(form);
    pending += 1;
    setState('Saving…', 'dirty');

    try {
      const response = await fetch(form.action || location.href, {
        method: 'POST',
        body,
        headers: { 'x-autosave': '1' },
        credentials: 'same-origin',
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.ok === false) {
        throw new Error(result.error || 'Could not save.');
      }

      if ((versions.get(form) ?? 0) === version) {
        dirty.delete(form);
        setState('Saved', 'saved');
      } else {
        setState('Unsaved changes', 'dirty');
        timers.set(form, window.setTimeout(() => save(form), 300));
      }
    } catch (error) {
      setState(error instanceof Error ? `Not saved: ${error.message}` : 'Not saved', 'error');
    } finally {
      pending -= 1;
    }
  };

  const schedule = (form: HTMLFormElement) => {
    dirty.add(form);
    versions.set(form, (versions.get(form) ?? 0) + 1);
    setState('Unsaved changes', 'dirty');
    const current = timers.get(form);
    if (current) window.clearTimeout(current);
    timers.set(form, window.setTimeout(() => save(form), 900));
  };

  document.querySelectorAll<HTMLFormElement>('form[data-autosave]').forEach((form) => {
    form.addEventListener('input', () => schedule(form));
    form.addEventListener('change', () => schedule(form));
  });

  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(form.dataset.confirm || 'Continue?')) {
        event.preventDefault();
      }
    });
  });

  const flush = async () => {
    for (let attempt = 0; attempt < 3 && dirty.size > 0; attempt += 1) {
      for (const form of [...dirty]) {
        const current = timers.get(form);
        if (current) window.clearTimeout(current);
        await save(form);
      }
    }
  };

  document.querySelectorAll<HTMLAnchorElement>('a[data-step-link]').forEach((link) => {
    link.addEventListener('click', async (event) => {
      if (dirty.size === 0 && pending === 0) return;
      event.preventDefault();
      await flush();
      window.location.href = link.href;
    });
  });

  window.addEventListener('beforeunload', (event) => {
    if (dirty.size === 0 && pending === 0) return;
    event.preventDefault();
    event.returnValue = '';
  });
</script>

