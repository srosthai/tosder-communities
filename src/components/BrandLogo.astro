---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Props {
  size?: number;
  alt?: string;
  class?: string;
}

const { size = 22, alt = '', class: className } = Astro.props;

let hasLogo = false;
try {
  hasLogo = existsSync(
    fileURLToPath(new URL('../../public/image/logo-no-bg.png', import.meta.url)),
  );
} catch {
  hasLogo = false;
}
---

{hasLogo ? (
  <img
    class:list={['brand-logo', className]}
    src="/image/logo-no-bg.png"
    alt={alt}
    height={size}
    style={`--logo-size: ${size}px;`}
  />
) : (
  <span
    class:list={['brand-logo', 'brand-logo--fallback', className]}
    style={`--logo-size: ${size}px;`}
    aria-hidden="true"
  >
    T
  </span>
)}

<style>
  .brand-logo {
    display: block;
    height: var(--logo-size);
    width: auto;
    flex: none;
    object-fit: contain;
  }

  .brand-logo--fallback {
    display: grid;
    place-items: center;
    width: var(--logo-size);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    line-height: 1;
  }
</style>
