---
import { Heart } from '@lucide/astro';

interface Props {
  id: string;
  liked: boolean;
  count: number;
  signedIn: boolean;
  redirectTo: string;
}

const { id, liked, count, signedIn, redirectTo } = Astro.props;
---

{signedIn ? (
  <button
    type="button"
    class:list={['like-button', { 'is-liked': liked }]}
    data-like-button
    data-like-id={id}
    data-liked={liked ? 'true' : 'false'}
    aria-pressed={liked ? 'true' : 'false'}
  >
    <Heart size={15} stroke-width={1.75} aria-hidden="true" fill={liked ? 'currentColor' : 'none'} />
    <span data-like-label>{liked ? 'Liked' : 'Like'}</span>
    <span class="like-count" data-like-count>{count}</span>
  </button>
) : (
  <a class="like-button" href={`/sign-in?redirectTo=${encodeURIComponent(redirectTo)}`}>
    <Heart size={15} stroke-width={1.75} aria-hidden="true" />
    <span>Like</span>
    <span class="like-count">{count}</span>
  </a>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-like-button]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (button.disabled) return;
      const id = button.dataset.likeId;
      const wasLiked = button.dataset.liked === 'true';
      const label = button.querySelector<HTMLElement>('[data-like-label]');
      const countEl = button.querySelector<HTMLElement>('[data-like-count]');
      const previousCount = Number(countEl?.textContent ?? '0');
      const nextLiked = !wasLiked;

      button.dataset.liked = String(nextLiked);
      button.classList.toggle('is-liked', nextLiked);
      button.setAttribute('aria-pressed', String(nextLiked));
      if (label) label.textContent = nextLiked ? 'Liked' : 'Like';
      if (countEl) countEl.textContent = String(Math.max(0, previousCount + (nextLiked ? 1 : -1)));
      button.disabled = true;

      try {
        const response = await fetch(`/api/likes/templates/${id}`, {
          method: nextLiked ? 'PUT' : 'DELETE',
          credentials: 'same-origin',
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error('Could not update the like.');

        button.dataset.liked = String(body.data.liked);
        button.classList.toggle('is-liked', body.data.liked);
        button.setAttribute('aria-pressed', String(body.data.liked));
        if (label) label.textContent = body.data.liked ? 'Liked' : 'Like';
        if (countEl) countEl.textContent = String(body.data.count);
      } catch {
        button.dataset.liked = String(wasLiked);
        button.classList.toggle('is-liked', wasLiked);
        button.setAttribute('aria-pressed', String(wasLiked));
        if (label) label.textContent = wasLiked ? 'Liked' : 'Like';
        if (countEl) countEl.textContent = String(previousCount);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .like-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    height: var(--control-height-md);
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .like-button:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .like-button.is-liked {
    border-color: color-mix(in oklch, var(--color-danger) 32%, transparent);
    color: var(--color-danger-text);
  }

  .like-count {
    min-width: 1.25rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-align: right;
  }
</style>
