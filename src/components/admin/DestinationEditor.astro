---
import Button from '../ui/Button.astro';
import Checkbox from '../ui/Checkbox.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Textarea from '../ui/Textarea.astro';

interface EditorPhoto {
  url: string;
  alt: string;
  credit: string | null;
}

export interface AdminDestination {
  id: string;
  name: string;
  slug: string;
  provinceId: string;
  summary: string | null;
  description: string | null;
  practicalTips: string | null;
  latitude: number | null;
  longitude: number | null;
  status: 'DRAFT' | 'PUBLISHED' | 'ARCHIVED';
  coverPhotoUrl: string | null;
  categoryIds: string[];
  tagIds: string[];
  photos: EditorPhoto[];
}

interface Props {
  mode: 'create' | 'edit';
  action: string;
  provinces: Array<{ id: string; name: string }>;
  categories: Array<{ id: string; name: string }>;
  tags: Array<{ id: string; name: string }>;
  destination?: AdminDestination;
  errorMessage?: string | null;
  saved?: boolean;
  publicUrl?: string | null;
}

const {
  mode,
  action,
  provinces,
  categories,
  tags,
  destination,
  errorMessage = null,
  saved = false,
  publicUrl = null,
} = Astro.props;

const selectedCategories = new Set(destination?.categoryIds ?? []);
const selectedTags = new Set(destination?.tagIds ?? []);
const existingPhotos = destination?.photos ?? [];
const photoCount = Math.max(4, existingPhotos.length);
const photos = Array.from({ length: photoCount }, (_, index) => existingPhotos[index] ?? {
  url: '',
  alt: '',
  credit: '',
});
const previewLabel =
  destination?.status === 'PUBLISHED' ? 'View public page' : 'Preview draft';
---

<div class="editor">
  {saved && <p class="notice notice--success" role="status">Destination saved.</p>}
  {errorMessage && <p class="notice notice--error" role="alert">{errorMessage}</p>}

  <form method="post" action={action} class="editor-form">
    <section class="editor-section" aria-labelledby="basics-heading">
      <div class="editor-section__header">
        <h2 id="basics-heading">Basics</h2>
        <p>The public name, URL, province, and lifecycle state.</p>
      </div>
      <div class="editor-grid">
        <Input label="Name" name="name" value={destination?.name ?? ''} required maxlength={120} />
        <Input
          label="Slug"
          name="slug"
          value={destination?.slug ?? ''}
          hint="Lowercase words separated by hyphens."
          required
          maxlength={120}
        />
        <Select label="Province" name="provinceId" required>
          <option value="">Choose a province</option>
          {provinces.map((province) => (
            <option value={province.id} selected={province.id === destination?.provinceId}>
              {province.name}
            </option>
          ))}
        </Select>
        <Select label="Status" name="status" required>
          <option value="DRAFT" selected={(destination?.status ?? 'DRAFT') === 'DRAFT'}>Draft</option>
          <option value="PUBLISHED" selected={destination?.status === 'PUBLISHED'}>Published</option>
          <option value="ARCHIVED" selected={destination?.status === 'ARCHIVED'}>Archived</option>
        </Select>
      </div>
    </section>

    <section class="editor-section" aria-labelledby="content-heading">
      <div class="editor-section__header">
        <h2 id="content-heading">Content</h2>
        <p>Short summary, full description, and the practical notes travelers need.</p>
      </div>
      <div class="editor-grid editor-grid--single">
        <Input
          label="Summary"
          name="summary"
          value={destination?.summary ?? ''}
          hint="One line used on cards and search results."
          maxlength={220}
        />
        <Textarea
          label="Description"
          name="description"
          value={destination?.description ?? ''}
          rows={6}
          maxlength={6000}
        />
        <Textarea
          label="Practical tips"
          name="practicalTips"
          value={destination?.practicalTips ?? ''}
          rows={4}
          maxlength={3000}
        />
      </div>
    </section>

    <section class="editor-section" aria-labelledby="location-heading">
      <div class="editor-section__header">
        <h2 id="location-heading">Location</h2>
        <p>Coordinates are validated on the server and synced to PostGIS.</p>
      </div>
      <div class="editor-grid">
        <Input
          label="Latitude"
          name="latitude"
          type="number"
          step="any"
          min="-90"
          max="90"
          value={destination?.latitude ?? ''}
          placeholder="13.4125"
        />
        <Input
          label="Longitude"
          name="longitude"
          type="number"
          step="any"
          min="-180"
          max="180"
          value={destination?.longitude ?? ''}
          placeholder="103.8670"
        />
      </div>
    </section>

    <section class="editor-section" aria-labelledby="classification-heading">
      <div class="editor-section__header">
        <h2 id="classification-heading">Classification</h2>
        <p>Choose at least one category for a published destination.</p>
      </div>
      <div class="check-grid">
        {categories.map((category) => (
          <Checkbox
            label={category.name}
            name="categoryIds"
            value={category.id}
            checked={selectedCategories.has(category.id)}
          />
        ))}
      </div>
      <h3>Tags</h3>
      <div class="check-grid">
        {tags.map((tag) => (
          <Checkbox
            label={tag.name}
            name="tagIds"
            value={tag.id}
            checked={selectedTags.has(tag.id)}
          />
        ))}
      </div>
    </section>

    <section class="editor-section" aria-labelledby="photos-heading">
      <div class="editor-section__header">
        <h2 id="photos-heading">Photos</h2>
        <p>URL-based for the MVP. Every published photo needs alt text and a rights note.</p>
      </div>
      <Input
        label="Cover photo URL"
        name="coverPhotoUrl"
        value={destination?.coverPhotoUrl ?? ''}
        hint="Optional. The first photo is used when this is empty."
        maxlength={600}
      />
      <div class="photo-list" data-photo-list>
        {photos.map((photo, index) => (
          <fieldset class="photo-row" data-photo-row>
            <legend><span data-photo-legend>Photo {index + 1}</span></legend>
            <div class="photo-grid">
              <Input label="Image URL" name="photoUrl" value={photo.url} maxlength={600} />
              <Input label="Alt text" name="photoAlt" value={photo.alt} maxlength={220} />
              <Input label="Credit / rights" name="photoCredit" value={photo.credit ?? ''} maxlength={220} />
            </div>
            <div class="photo-row__actions">
              <button
                type="button"
                class="move-button"
                data-photo-move="up"
                aria-label={`Move photo ${index + 1} up`}
                disabled={index === 0}
              >
                ↑ Move up
              </button>
              <button
                type="button"
                class="move-button"
                data-photo-move="down"
                aria-label={`Move photo ${index + 1} down`}
                disabled={index === photos.length - 1}
              >
                ↓ Move down
              </button>
            </div>
          </fieldset>
        ))}
      </div>
    </section>

    <div class="editor-actions">
      <a class="cancel-link" href="/admin/content">Cancel</a>
      {publicUrl && (
        <a class="preview-link" href={publicUrl} target="_blank" rel="noreferrer">
          {previewLabel}
        </a>
      )}
      <Button type="submit" variant="primary">
        {mode === 'create' ? 'Create destination' : 'Save changes'}
      </Button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-photo-list]').forEach((list) => {
    const relabel = () => {
      const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-photo-row]'));

      rows.forEach((row, index) => {
        const legend = row.querySelector<HTMLElement>('[data-photo-legend]');
        if (legend) legend.textContent = `Photo ${index + 1}`;

        row.querySelectorAll<HTMLButtonElement>('[data-photo-move]').forEach((button) => {
          const direction = button.dataset.photoMove;
          button.setAttribute('aria-label', `Move photo ${index + 1} ${direction}`);
          button.disabled =
            (direction === 'up' && index === 0) ||
            (direction === 'down' && index === rows.length - 1);
        });
      });
    };

    list.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-photo-move]',
      );
      if (!button) return;

      const row = button.closest<HTMLElement>('[data-photo-row]');
      if (!row) return;

      if (button.dataset.photoMove === 'up') {
        const previous = row.previousElementSibling;
        if (previous) list.insertBefore(row, previous);
      } else {
        const next = row.nextElementSibling;
        if (next) list.insertBefore(next, row);
      }

      relabel();
      row.querySelector<HTMLInputElement>('input[name="photoUrl"]')?.focus();
    });

    relabel();
  });
</script>

<style>
  .editor {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .notice {
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .notice--success {
    background: var(--color-success-bg);
    color: var(--color-success-text);
    border-color: color-mix(in oklch, var(--color-success) 40%, transparent);
  }

  .notice--error {
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
    border-color: color-mix(in oklch, var(--color-danger) 40%, transparent);
  }

  .editor-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .editor-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .editor-section__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .editor-section__header h2 {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .editor-section__header p {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: right;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .editor-grid--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .check-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-2);
  }

  h3 {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .photo-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .photo-row {
    margin: 0;
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .photo-row legend {
    padding: 0 var(--space-1);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .photo-row__actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .move-button {
    padding: var(--space-1) var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .move-button:hover:not(:disabled) {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .move-button:disabled {
    opacity: 0.4;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-3);
  }

  .editor-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    position: sticky;
    bottom: 0;
    padding: var(--space-3) 0;
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
  }

  .cancel-link,
  .preview-link {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cancel-link:hover,
  .preview-link:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .editor-actions :global(.btn) {
    margin-left: auto;
  }

  @media (max-width: 900px) {
    .editor-grid,
    .photo-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .editor-section__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .editor-section__header p {
      text-align: left;
    }
  }
</style>
