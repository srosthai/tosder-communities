---
interface TabItem {
  label: string;
  href: string;
  active?: boolean;
  count?: number;
}

interface Props {
  items: TabItem[];
  ariaLabel?: string;
  variant?: 'underline' | 'segmented';
  class?: string;
}

const {
  items,
  ariaLabel = 'Tabs',
  variant = 'underline',
  class: className,
} = Astro.props;
---

<nav class:list={['tabs', `tabs--${variant}`, className]} aria-label={ariaLabel}>
  {items.map((item) => (
    <a
      class:list={['tabs__item', { 'is-active': item.active }]}
      href={item.href}
      aria-current={item.active ? 'page' : undefined}
    >
      {item.label}
      {typeof item.count === 'number' && <span class="tabs__count">{item.count}</span>}
    </a>
  ))}
</nav>

<style>
  .tabs {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .tabs--underline {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .tabs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: var(--control-height-lg);
    padding: 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .tabs--underline .tabs__item {
    margin-bottom: calc(var(--border-width) * -1);
    border-bottom: 2px solid transparent;
  }

  .tabs--underline .tabs__item:hover {
    color: var(--color-text);
  }

  .tabs--underline .tabs__item.is-active {
    border-bottom-color: var(--color-accent);
    color: var(--color-text);
  }

  .tabs--segmented {
    padding: var(--space-1);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .tabs--segmented .tabs__item {
    height: var(--control-height-sm);
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .tabs--segmented .tabs__item:hover {
    color: var(--color-text);
  }

  .tabs--segmented .tabs__item.is-active {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .tabs__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 var(--space-1);
    border-radius: var(--radius-full);
    background: var(--color-surface-sunken);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }

  .tabs__item.is-active .tabs__count {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
</style>
