---
import { ArrowRight, Menu, Moon, Sun, X } from '@lucide/astro';
import BaseLayout from './BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { getAuthForRequest } from '../lib/auth-server';

interface Props {
  title: string;
  description?: string;
  user?: { name: string; initials?: string } | null;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = 'Discover Cambodia, create reusable itineraries, and share travel templates.',
  user: providedUser = null,
  canonical,
  image,
  imageAlt,
  noindex,
  type,
  jsonLd,
} = Astro.props;

const cookieHeader = Astro.request.headers.get('cookie') ?? '';
let user = providedUser;

if (!user && cookieHeader) {
  try {
    const auth = getAuthForRequest(Astro);
    const { data } = await auth.getSession();
    if (data?.user) {
      user = {
        name: data.user.name,
        initials: data.user.name
          .split(' ')
          .filter(Boolean)
          .slice(0, 2)
          .map((part) => part[0])
          .join('')
          .toUpperCase(),
      };
    }
  } catch {
    user = providedUser;
  }
}

const navItems = [
  { label: 'Explore', href: '/explore' },
  { label: 'Travel templates', href: '/templates' },
  { label: 'Leaderboard', href: '/leaderboard' },
];
---

<BaseLayout
  title={title}
  description={description}
  surface="public"
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  type={type}
  jsonLd={jsonLd}
>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <BrandLogo size={24} />
        <span class="brand__name">Tosder <span>Communities</span></span>
      </a>

      <nav class="desktop-nav" aria-label="Primary">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="header-actions">
        <button
          type="button"
          class="icon-button"
          data-public-theme-toggle
          aria-label="Switch to dark theme"
          title="Switch to dark theme"
        >
          <Sun class="theme-icon theme-icon--sun" size={16} stroke-width={1.75} />
          <Moon class="theme-icon theme-icon--moon" size={16} stroke-width={1.75} />
        </button>

        {user ? (
          <a class="account" href="/account">
            <span class="avatar" aria-hidden="true">{user.initials ?? user.name.slice(0, 2).toUpperCase()}</span>
            <span>{user.name}</span>
          </a>
        ) : (
          <>
            <a class="signin" href="/sign-in">Sign in</a>
            <a class="cta" href="/sign-up">
              Get started
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </>
        )}

        <button
          type="button"
          class="mobile-toggle"
          data-mobile-toggle
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <Menu size={20} stroke-width={1.75} aria-hidden="true" />
        </button>
      </div>
    </div>
  </header>

  <div class="mobile-backdrop" data-mobile-backdrop></div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu__header">
      <a class="brand" href="/">
        <BrandLogo size={24} />
        <span class="brand__name">Tosder <span>Communities</span></span>
      </a>
      <button type="button" class="icon-button" data-mobile-close aria-label="Close menu">
        <X size={18} stroke-width={1.75} />
      </button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile primary">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="mobile-menu__actions">
      {user ? (
        <a class="cta" href="/account">Open account</a>
      ) : (
        <>
          <a class="signin" href="/sign-in">Sign in</a>
          <a class="cta" href="/sign-up">Get started</a>
        </>
      )}
    </div>
    <div class="mobile-menu__footer">
      <a href="/status">System status</a>
      <a href="/design">Design system</a>
    </div>
  </div>

  <main id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a class="brand" href="/">
          <BrandLogo size={22} />
          <span class="brand__name">Tosder <span>Communities</span></span>
        </a>
        <p>Cambodia travel, planned by people who have been there.</p>
        <p class="footer-copy">© 2026 Tosder Communities</p>
      </div>

      <div class="footer-columns">
        <div class="footer-column">
          <h2>Discover</h2>
          <a href="/explore">Explore</a>
          <a href="/templates">Travel templates</a>
          <a href="/leaderboard">Leaderboard</a>
        </div>
        <div class="footer-column">
          <h2>Build</h2>
          <a href="/sign-in">Sign in</a>
          <a href="/sign-up">Create an account</a>
          <a href="/status">System status</a>
        </div>
        <div class="footer-column">
          <h2>Resources</h2>
          <a href="/design">Design system</a>
          <a href="/admin">Admin preview</a>
        </div>
        <div class="footer-column">
          <h2>Legal</h2>
          <a href="/legal/privacy">Privacy</a>
          <a href="/legal/terms">Terms</a>
          <a href="/legal/community-guidelines">Community guidelines</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    (() => {
      const shellWindow = window as Window & { __tosderPublicShellBound?: boolean };
      if (shellWindow.__tosderPublicShellBound) return;
      shellWindow.__tosderPublicShellBound = true;

      const themeToggle = () =>
        document.querySelector<HTMLButtonElement>('[data-public-theme-toggle]');
      const mobileToggle = () =>
        document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
      const mobileMenu = () => document.querySelector<HTMLElement>('[data-mobile-menu]');
      const mobileBackdrop = () =>
        document.querySelector<HTMLElement>('[data-mobile-backdrop]');

      const updateThemeLabel = () => {
        const dark = document.documentElement.classList.contains('dark');
        const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
        const button = themeToggle();
        button?.setAttribute('aria-label', label);
        button?.setAttribute('title', label);
        button?.setAttribute('aria-pressed', String(dark));
      };

      const toggleTheme = () => {
        const root = document.documentElement;
        const dark = !root.classList.contains('dark');
        root.classList.toggle('dark', dark);
        root.dataset.theme = dark ? 'dark' : 'light';
        localStorage.setItem('tosder-theme', dark ? 'dark' : 'light');
        updateThemeLabel();
      };

      const setMobileMenu = (open: boolean, restoreFocus = true) => {
        const menu = mobileMenu();
        const toggle = mobileToggle();
        const backdrop = mobileBackdrop();
        if (!menu || !toggle || !backdrop) return;

        menu.classList.toggle('is-open', open);
        backdrop.classList.toggle('is-open', open);
        menu.setAttribute('aria-hidden', String(!open));
        toggle.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';

        if (open) {
          const initialFocus =
            menu.querySelector<HTMLElement>('.mobile-nav a') ??
            menu.querySelector<HTMLElement>('a, button');
          requestAnimationFrame(() => initialFocus?.focus());
        } else if (restoreFocus) {
          toggle.focus();
        }
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        if (target.closest('[data-public-theme-toggle]')) {
          toggleTheme();
          return;
        }
        if (target.closest('[data-mobile-toggle]')) {
          setMobileMenu(!mobileMenu()?.classList.contains('is-open'));
          return;
        }
        if (target.closest('[data-mobile-close]') || target.closest('[data-mobile-backdrop]')) {
          setMobileMenu(false);
          return;
        }
        if (target.closest('[data-mobile-menu] a')) {
          setMobileMenu(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        const menu = mobileMenu();
        if (!menu?.classList.contains('is-open')) return;

        if (event.key === 'Escape') {
          setMobileMenu(false);
          return;
        }
        if (event.key !== 'Tab') return;

        const focusable = Array.from(
          menu.querySelectorAll<HTMLElement>('a, button'),
        ).filter((element) => !element.hasAttribute('disabled'));
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      document.addEventListener('astro:page-load', () => {
        updateThemeLabel();
        setMobileMenu(false, false);
      });

      updateThemeLabel();
    })();
  </script>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      z-index: 40;
      border-bottom: var(--border-width) solid var(--color-border);
      background: color-mix(in oklab, var(--color-bg) 88%, transparent);
      backdrop-filter: blur(14px);
    }

    .container {
      width: min(100% - var(--space-8), 72rem);
      margin: 0 auto;
    }

    .header-inner {
      display: flex;
      align-items: center;
      gap: var(--space-6);
      height: 3.5rem;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-width: 0;
      color: var(--color-text);
    }

    .brand__name {
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .brand__name span {
      color: var(--color-text-muted);
      font-weight: var(--weight-regular);
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .desktop-nav a {
      padding: var(--space-2) var(--space-2);
      border-radius: var(--radius-sm);
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      text-decoration: none;
    }

    .desktop-nav a:hover {
      background: var(--color-bg-subtle);
      color: var(--color-text);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-left: auto;
    }

    .icon-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--control-height-md);
      height: var(--control-height-md);
      padding: 0;
      border: var(--border-width) solid transparent;
      border-radius: var(--radius-md);
      background: transparent;
      color: var(--color-text-muted);
    }

    .icon-button:hover {
      background: var(--color-bg-subtle);
      color: var(--color-text);
    }

    .theme-icon--sun {
      display: none;
    }

    .dark .theme-icon--sun {
      display: block;
    }

    .dark .theme-icon--moon {
      display: none;
    }

    .signin {
      padding: var(--space-2) var(--space-2);
      border-radius: var(--radius-sm);
      color: var(--color-text-muted);
      font-size: var(--text-sm);
    }

    .signin:hover {
      color: var(--color-text);
    }

    .cta {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      height: var(--control-height-md);
      padding: 0 var(--space-3);
      border-radius: var(--radius-md);
      background: var(--color-accent);
      color: var(--color-accent-contrast);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      white-space: nowrap;
    }

    .cta:hover {
      background: var(--color-accent-hover);
    }

    .account {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      height: var(--control-height-md);
      padding: 0 var(--space-1);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-size: var(--text-sm);
    }

    .account:hover {
      background: var(--color-bg-subtle);
    }

    .avatar {
      display: inline-grid;
      place-items: center;
      width: 1.375rem;
      height: 1.375rem;
      border-radius: var(--radius-full);
      background: var(--color-accent);
      color: var(--color-accent-contrast);
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
    }

    .mobile-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: var(--control-height-md);
      height: var(--control-height-md);
      padding: 0;
      border: var(--border-width) solid transparent;
      border-radius: var(--radius-md);
      background: transparent;
      color: var(--color-text-muted);
    }

    .mobile-toggle:hover {
      background: var(--color-bg-subtle);
      color: var(--color-text);
    }

    .mobile-backdrop {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: rgb(0 0 0 / 0.45);
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--duration-base) var(--ease-standard);
    }

    .mobile-backdrop.is-open {
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 60;
      display: flex;
      flex-direction: column;
      width: min(22rem, 88vw);
      height: 100dvh;
      padding: var(--space-4);
      border-left: var(--border-width) solid var(--color-border);
      background: var(--color-bg);
      transform: translateX(100%);
      visibility: hidden;
      transition: transform var(--duration-base) var(--ease-standard);
    }

    .mobile-menu.is-open {
      transform: translateX(0);
      visibility: visible;
    }

    .mobile-menu__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-bottom: var(--space-4);
      border-bottom: var(--border-width) solid var(--color-border);
    }

    .mobile-nav {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-4) 0;
    }

    .mobile-nav a {
      display: flex;
      align-items: center;
      min-height: 2.5rem;
      padding: 0 var(--space-2);
      border-radius: var(--radius-md);
      color: var(--color-text-muted);
      font-size: var(--text-lg);
    }

    .mobile-nav a:hover {
      background: var(--color-bg-subtle);
      color: var(--color-text);
    }

    .mobile-menu__actions {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-top: auto;
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--color-border);
    }

    .mobile-menu__actions .cta,
    .mobile-menu__actions .signin {
      justify-content: center;
      height: var(--control-height-lg);
      font-size: var(--text-md);
    }

    .mobile-menu__footer {
      display: flex;
      gap: var(--space-4);
      padding-top: var(--space-4);
      color: var(--color-text-subtle);
      font-size: var(--text-xs);
    }

    .mobile-menu__footer a:hover {
      color: var(--color-text);
    }

    .site-footer {
      border-top: var(--border-width) solid var(--color-border);
      background: var(--color-bg-subtle);
    }

    .footer-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.8fr);
      gap: var(--space-10);
      padding: var(--space-10) 0 var(--space-8);
    }

    .footer-brand {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .footer-brand > p {
      max-width: 30ch;
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      line-height: var(--leading-relaxed);
    }

    .footer-copy {
      margin-top: var(--space-2);
      color: var(--color-text-subtle) !important;
      font-size: var(--text-xs) !important;
    }

    .footer-columns {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .footer-column {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .footer-column h2 {
      margin-bottom: var(--space-1);
      color: var(--color-text);
      font-size: var(--text-xs);
      font-weight: var(--weight-medium);
    }

    .footer-column a {
      color: var(--color-text-muted);
      font-size: var(--text-sm);
    }

    .footer-column a:hover {
      color: var(--color-text);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    @media (max-width: 900px) {
      .desktop-nav {
        display: none;
      }

      .mobile-toggle {
        display: inline-flex;
      }

      .footer-inner {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-8);
      }
    }

    @media (max-width: 720px) {
      .signin,
      .header-actions .cta {
        display: none;
      }

      .header-inner {
        gap: var(--space-3);
      }

      .footer-columns {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 420px) {
      .brand__name span {
        display: none;
      }

      .footer-columns {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</BaseLayout>
