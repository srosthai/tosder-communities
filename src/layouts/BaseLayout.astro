---
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'admin';
  bodyClass?: string;
}

const {
  title,
  description = 'Tosder Communities — discover Cambodia, create reusable itineraries, and share travel templates.',
  theme = 'light',
  bodyClass,
} = Astro.props;

const themeColor = theme === 'admin' ? '#09090b' : '#ffffff';
---

<!doctype html>
<html lang="en" data-theme={theme} class:list={[{ dark: theme === 'admin' }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
