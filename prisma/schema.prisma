generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNLISTED
  ARCHIVED
}

enum TemplateItemType {
  ATTRACTION
  FOOD
  REST
  TRANSPORT
  SHOPPING
  ACCOMMODATION
  CUSTOM
}

enum TripStatus {
  DRAFT
  PLANNED
  COMPLETED
  ARCHIVED
}

enum UsageStatus {
  PENDING
  QUALIFIED
  REJECTED
  VOID
  INVALID
  UNDER_REVIEW
}

enum EngagementType {
  VIEW
  LIKE
  SAVE
  USE_STARTED
}

enum ReviewStatus {
  VISIBLE
  REPORTED
  HIDDEN
}

enum MemberRole {
  MEMBER
  TRUSTED_CREATOR
  MODERATOR
  ADMINISTRATOR
}

enum ReportTargetType {
  TEMPLATE
  REVIEW
  USER
  COMMENT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  CLOSED
  FINALIZED
}

enum LeaderboardStatus {
  PROVISIONAL
  FINAL
  SUPERSEDED
}

// Temporary connectivity model. Remove once the status smoke test is replaced
// by a real health check.
model Todo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("todos")
}

model Province {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String        @unique
  summary      String?
  description  String?
  heroImageUrl String?       @map("hero_image_url")
  status       ContentStatus @default(DRAFT)
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  districts      District[]
  destinations   Destination[]
  templates      TravelTemplate[]

  @@index([status])
  @@index([name])
  @@map("provinces")
}

model District {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provinceId String        @map("province_id") @db.Uuid
  name       String
  slug       String        @unique
  status     ContentStatus @default(DRAFT)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  province     Province      @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  destinations Destination[]

  @@index([provinceId])
  @@index([status])
  @@map("districts")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  destinations DestinationCategory[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  destinations DestinationTag[]

  @@map("tags")
}

model Destination {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provinceId     String        @map("province_id") @db.Uuid
  districtId     String?       @map("district_id") @db.Uuid
  name           String
  slug           String        @unique
  summary        String?
  description    String?
  practicalTips  String?       @map("practical_tips")
  latitude       Float?
  longitude      Float?
  // PostGIS column managed by the geography migration and sync trigger.
  location       Unsupported("geography(Point, 4326)")?
  status         ContentStatus @default(DRAFT)
  coverPhotoUrl  String?       @map("cover_photo_url")
  sortOrder      Int           @default(0) @map("sort_order")
  saveCount      Int           @default(0) @map("save_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  province    Province      @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district    District?     @relation(fields: [districtId], references: [id], onDelete: SetNull)
  photos      DestinationPhoto[]
  categories  DestinationCategory[]
  tags        DestinationTag[]
  collections FeaturedCollectionItem[]
  templateItems TemplateItem[]
  tripItems UserTripItem[]
  savedBy SavedDestination[]

  @@index([provinceId])
  @@index([districtId])
  @@index([status])
  @@index([provinceId, status])
  @@index([name])
  @@index([location], type: Gist)
  @@map("destinations")
}

model DestinationPhoto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  url           String
  alt           String
  credit        String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, sortOrder])
  @@index([destinationId])
  @@map("destination_photos")
}

model DestinationCategory {
  destinationId String @map("destination_id") @db.Uuid
  categoryId    String @map("category_id") @db.Uuid

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([destinationId, categoryId])
  @@index([categoryId])
  @@map("destination_categories")
}

model DestinationTag {
  destinationId String @map("destination_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([destinationId, tagId])
  @@index([tagId])
  @@map("destination_tags")
}

model FeaturedCollection {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  items FeaturedCollectionItem[]

  @@index([status])
  @@map("featured_collections")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String
  metadata   Json?
  requestId  String?  @map("request_id")
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@index([createdAt])
  @@index([actorEmail])
  @@map("audit_events")
}

model MemberProfile {
  userId      String   @id @map("user_id")
  username    String   @unique
  displayName String   @map("display_name")
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  socialLinks Json?    @map("social_links")
  trustedCreator Boolean @default(false) @map("trusted_creator")
  role        MemberRole @default(MEMBER)
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  templates TravelTemplate[] @relation("TemplateCreator")
  trips     UserTrip[]
  usageEvents UsageEvent[]
  savedTemplates SavedTemplate[]
  savedDestinations SavedDestination[]
  reviews   TripReview[]
  likes     TemplateLike[]
  engagementEvents EngagementEvent[]
  rewards   Reward[]
  reportsMade Report[] @relation("ReportedBy")
  notifications MemberNotification[]

  @@index([username])
  @@map("member_profiles")
}

model TravelTemplate {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId          String         @map("creator_id")
  provinceId         String?        @map("province_id") @db.Uuid
  title              String
  slug               String         @unique
  summary            String?
  description        String?
  coverPhotoUrl      String?        @map("cover_photo_url")
  durationDays       Int            @default(1) @map("duration_days")
  budgetMinCents     Int?           @map("budget_min_cents")
  budgetMaxCents     Int?           @map("budget_max_cents")
  currency           String         @default("USD")
  style              String?
  season             String?
  logisticsNotes     String?        @map("logistics_notes")
  transport          String[]       @default([])
  audience           String[]       @default([])
  language           String         @default("en")
  status             TemplateStatus @default(DRAFT)
  publishedVersionId String?        @unique @map("published_version_id") @db.Uuid
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(6)
  reviewedById       String?        @map("reviewed_by_id")
  reviewedAt         DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason    String?        @map("rejection_reason")
  viewCount          Int            @default(0) @map("view_count")
  likeCount          Int            @default(0) @map("like_count")
  useStartedCount    Int            @default(0) @map("use_started_count")
  saveCount          Int            @default(0) @map("save_count")
  qualifiedUseCount  Int            @default(0) @map("qualified_use_count")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator          MemberProfile    @relation("TemplateCreator", fields: [creatorId], references: [userId], onDelete: Restrict)
  province         Province?        @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  days             TemplateDay[]
  versions         TemplateVersion[] @relation("TemplateVersions")
  publishedVersion TemplateVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  trips             UserTrip[]       @relation("TripSourceTemplate")
  usageEvents       UsageEvent[]
  savedBy           SavedTemplate[]
  reviews           TripReview[]
  likes             TemplateLike[]
  engagementEvents  EngagementEvent[]

  @@index([creatorId])
  @@index([provinceId])
  @@index([status])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([title])
  @@map("travel_templates")
}

model TemplateDay {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  dayNumber   Int      @map("day_number")
  title       String?
  summary     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  template TravelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    TemplateItem[]

  @@unique([templateId, dayNumber])
  @@index([templateId])
  @@map("template_days")
}

model TemplateItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayId              String           @map("day_id") @db.Uuid
  destinationId      String?          @map("destination_id") @db.Uuid
  title              String
  type               TemplateItemType @default(ATTRACTION)
  description        String?
  practicalTips      String?          @map("practical_tips")
  startTime          String?          @map("start_time")
  endTime            String?          @map("end_time")
  durationMinutes    Int?             @map("duration_minutes")
  estimatedCostCents Int?             @map("estimated_cost_cents")
  currency           String           @default("USD")
  sortOrder          Int              @default(0) @map("sort_order")
  photoUrl           String?          @map("photo_url")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  day         TemplateDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@unique([dayId, sortOrder])
  @@index([dayId])
  @@index([destinationId])
  @@map("template_items")
}

model TemplateVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  versionNumber Int      @map("version_number")
  createdById   String   @map("created_by_id")
  snapshot      Json
  validation    Json?
  contentHash   String?  @map("content_hash")
  changeNote    String?  @map("change_note")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template          TravelTemplate  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  publishedTemplate TravelTemplate? @relation("PublishedVersion")
  trips             UserTrip[]       @relation("TripSourceVersion")
  usageEvents       UsageEvent[]
  reviews           TripReview[]

  @@unique([templateId, versionNumber])
  @@unique([templateId, contentHash])
  @@index([templateId])
  @@index([createdAt])
  @@map("template_versions")
}

model FeaturedCollectionItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId  String   @map("collection_id") @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection  FeaturedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  destination Destination        @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([collectionId, destinationId])
  @@unique([collectionId, sortOrder])
  @@index([destinationId])
  @@map("featured_collection_items")
}

model UserTrip {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                 String     @map("owner_id")
  title                   String
  status                  TripStatus @default(DRAFT)
  startDate               DateTime?  @map("start_date") @db.Date
  endDate                 DateTime?  @map("end_date") @db.Date
  timezone                String     @default("Asia/Phnom_Penh")
  notes                   String?
  sourceTemplateId        String?    @map("source_template_id") @db.Uuid
  sourceTemplateVersionId String?    @map("source_template_version_id") @db.Uuid
  sourceTemplateTitle     String?    @map("source_template_title")
  sourceVersionNumber     Int?       @map("source_version_number")
  copyKey                 String?    @map("copy_key")
  copiedAt                DateTime?  @map("copied_at") @db.Timestamptz(6)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner                MemberProfile     @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  sourceTemplate       TravelTemplate?   @relation("TripSourceTemplate", fields: [sourceTemplateId], references: [id], onDelete: Restrict)
  sourceTemplateVersion TemplateVersion? @relation("TripSourceVersion", fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  days                 UserTripDay[]
  checklist            UserTripChecklistItem[]
  usageEvent           UsageEvent?
  review               TripReview?

  @@unique([ownerId, copyKey])
  @@index([ownerId, status])
  @@index([ownerId, startDate])
  @@index([sourceTemplateId])
  @@map("user_trips")
}

model UserTripDay {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  dayNumber Int      @map("day_number")
  date      DateTime? @db.Date
  title     String?
  summary   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip  UserTrip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items UserTripItem[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
  @@map("user_trip_days")
}

model UserTripItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayId              String           @map("day_id") @db.Uuid
  destinationId      String?          @map("destination_id") @db.Uuid
  title              String
  type               TemplateItemType @default(ATTRACTION)
  description        String?
  practicalTips      String?          @map("practical_tips")
  notes              String?
  startTime          String?          @map("start_time")
  endTime            String?          @map("end_time")
  durationMinutes    Int?             @map("duration_minutes")
  estimatedCostCents Int?             @map("estimated_cost_cents")
  currency           String           @default("USD")
  sortOrder          Int              @default(0) @map("sort_order")
  photoUrl           String?          @map("photo_url")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  day         UserTripDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@unique([dayId, sortOrder])
  @@index([dayId])
  @@index([destinationId])
  @@map("user_trip_items")
}

model UserTripChecklistItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip UserTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, sortOrder])
  @@index([tripId])
  @@map("user_trip_checklist_items")
}

model UsageEvent {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String      @map("user_id")
  templateId        String?     @map("template_id") @db.Uuid
  templateVersionId String?     @map("template_version_id") @db.Uuid
  tripId            String      @unique @map("trip_id") @db.Uuid
  eventType         String      @default("template_copy") @map("event_type")
  status            UsageStatus @default(PENDING)
  requestId         String?     @map("request_id")
  idempotencyKey    String?     @map("idempotency_key")
  metadata          Json?
  periodKey         String?     @map("period_key")
  ruleVersion       String      @default("v1") @map("rule_version")
  qualifiedAt       DateTime?   @map("qualified_at") @db.Timestamptz(6)
  decidedAt         DateTime?   @map("decided_at") @db.Timestamptz(6)
  decisionReason    String?     @map("decision_reason")
  reviewedById      String?     @map("reviewed_by_id")
  reviewedAt        DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user            MemberProfile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  template        TravelTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  trip            UserTrip        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@unique([userId, templateId, periodKey])
  @@index([userId, status])
  @@index([templateId, periodKey])
  @@index([templateId])
  @@index([createdAt])
  @@map("usage_events")
}

model SavedTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id")
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     MemberProfile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  template TravelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
  @@index([userId, createdAt])
  @@map("saved_templates")
}

model SavedDestination {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id")
  destinationId String   @map("destination_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        MemberProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  destination Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([destinationId])
  @@index([userId, createdAt])
  @@map("saved_destinations")
}

model TripReview {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId            String       @unique @map("trip_id") @db.Uuid
  templateId        String       @map("template_id") @db.Uuid
  templateVersionId String?      @map("template_version_id") @db.Uuid
  reviewerId        String       @map("reviewer_id")
  rating            Int
  body              String?
  status            ReviewStatus @default(VISIBLE)
  reportReason      String?      @map("report_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  editedAt          DateTime?    @map("edited_at") @db.Timestamptz(6)

  trip            UserTrip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  template        TravelTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  reviewer        MemberProfile   @relation(fields: [reviewerId], references: [userId], onDelete: Cascade)

  @@index([templateId, status])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("trip_reviews")
}

model TemplateLike {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id")
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     MemberProfile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  template TravelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
  @@map("template_likes")
}

model EngagementEvent {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String         @map("template_id") @db.Uuid
  userId     String?        @map("user_id")
  eventType  EngagementType @map("event_type")
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  dedupeKey  String?        @unique @map("dedupe_key")
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  template TravelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     MemberProfile? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([templateId, eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("engagement_events")
}

model Competition {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  slug           String            @unique
  description    String?
  rules          String?
  rulesUrl       String?           @map("rules_url")
  status         CompetitionStatus @default(DRAFT)
  timezone       String            @default("Asia/Phnom_Penh")
  startsAt       DateTime?         @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?         @map("ends_at") @db.Timestamptz(6)
  prizePoolCents Int?              @map("prize_pool_cents")
  currency       String            @default("USD")
  fundingSource  String?           @map("funding_source")
  createdById    String            @map("created_by_id")
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)
  finalizedAt    DateTime?         @map("finalized_at") @db.Timestamptz(6)
  version        Int               @default(1)
  changeReason   String?           @map("change_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  prizes    CompetitionPrize[]
  snapshots LeaderboardSnapshot[]
  rewards   Reward[]

  @@index([status, startsAt])
  @@map("competitions")
}

model CompetitionPrize {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId String @map("competition_id") @db.Uuid
  rank          Int
  amountCents   Int    @map("amount_cents")
  label         String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, rank])
  @@index([competitionId])
  @@map("competition_prizes")
}

model LeaderboardSnapshot {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId String            @map("competition_id") @db.Uuid
  versionNumber Int               @map("version_number")
  status        LeaderboardStatus @default(PROVISIONAL)
  ruleVersion   String            @default("v1") @map("rule_version")
  entries       Json
  generatedAt   DateTime          @default(now()) @map("generated_at") @db.Timestamptz(6)
  createdById   String            @map("created_by_id")

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, versionNumber])
  @@index([competitionId, status])
  @@map("leaderboard_snapshots")
}

model Reward {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId  String       @map("competition_id") @db.Uuid
  rank           Int
  recipientId    String       @map("recipient_id")
  amountCents    Int          @map("amount_cents")
  currency       String       @default("USD")
  status         RewardStatus @default(PENDING)
  reason         String?
  approvedById   String?      @map("approved_by_id")
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(6)
  payoutReference String?     @unique @map("payout_reference")
  payoutMethod   String?      @map("payout_method")
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(6)
  proofUrl       String?      @map("proof_url")
  voidReason     String?      @map("void_reason")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  recipient   MemberProfile @relation(fields: [recipientId], references: [userId], onDelete: Restrict)

  @@unique([competitionId, rank])
  @@index([competitionId, status])
  @@index([recipientId])
  @@map("rewards")
}

enum RewardStatus {
  PENDING
  APPROVED
  PAYABLE
  PAID
  VOID
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String           @map("reporter_id")
  targetType     ReportTargetType @map("target_type")
  targetId       String           @map("target_id")
  reasonCode     String           @map("reason_code")
  details        String?
  status         ReportStatus     @default(OPEN)
  priority       ReportPriority   @default(MEDIUM)
  internalNote   String?          @map("internal_note")
  assignedToId   String?          @map("assigned_to_id")
  resolutionAction String?        @map("resolution_action")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)

  reporter MemberProfile @relation("ReportedBy", fields: [reporterId], references: [userId], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, priority, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model MemberNotification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user MemberProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("member_notifications")
}
